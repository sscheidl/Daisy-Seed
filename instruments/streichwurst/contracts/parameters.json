    "streichwurst": {
      "schema": 1,
      "parameters": [
        {"id": 1, "key": "balance", "label": "Balance strings/solo", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 50, "cc": 8, "control": "VR4 Main, VR8 FX", "page": "global"},
