        {"id": 3, "key": "midi_channel", "label": "MIDI channel (0 = omni)", "type": "int", "unit": "channel", "min": 0, "max": 16, "default": 0, "cc": null, "page": "global"},
        {"id": 4, "key": "pot_page", "label": "Pot page on the kit", "type": "enum", "unit": "none", "min": 0, "max": 2, "default": 0, "cc": null, "control": "S9", "page": "global", "flags": ["readonly"],
