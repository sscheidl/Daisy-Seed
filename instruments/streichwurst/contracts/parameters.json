        {"id": 13, "key": "split_key", "label": "Split key (MIDI note)", "type": "int", "unit": "none", "min": 0, "max": 127, "default": 60, "cc": 85, "control": "VR7 Solo", "page": "keyboard"},
        {"id": 14, "key": "string_velocity", "label": "Velocity (strings)", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 0, "cc": 86, "page": "strings"},
        {"id": 15, "key": "solo_velocity", "label": "Velocity (solo)", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 100, "cc": 87, "page": "solo"},
