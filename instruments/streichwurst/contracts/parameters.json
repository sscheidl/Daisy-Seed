        {"id": 17, "key": "transpose", "label": "Transpose", "type": "int", "unit": "semitones", "min": -24, "max": 24, "default": 0, "cc": null, "page": "keyboard"},
        {"id": 18, "key": "tune", "label": "Tune", "type": "float", "unit": "cents", "min": -50, "max": 50, "default": 0, "cc": null, "page": "keyboard"}
