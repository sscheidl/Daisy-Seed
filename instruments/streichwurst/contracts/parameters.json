{
  "format_version": 1,
  "note": "Stable parameter IDs, ranges and CC plan of the Streichwurst components (docs/PARAMETERS.md). IDs never change meaning; new parameters get new IDs. Values travel as i32 milli-units (value * 1000) over SQ. Types, units and flags are the shared SQ lists of sequencers/step-seq/contracts/parameters.json.",
  "units": ["none", "percent", "hz", "ms", "db", "semitones", "cents", "bpm", "channel", "velocity"],
  "types": ["float", "int", "enum", "bool"],
  "flags": {"readonly": 1, "log": 2},
  "cc_channel": "midi_channel",
  "components": {
