        {"id": 5, "key": "phaser", "label": "Phaser", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 0, "cc": 106, "control": "VR6 Main, VR3 FX", "page": "fx"},
        {"id": 6, "key": "phaser_rate", "label": "Phaser rate (own)", "type": "float", "unit": "hz", "min": 0.05, "max": 5, "default": 0.4, "cc": 107, "control": "VR4 FX", "page": "fx", "flags": ["log"]},
        {"id": 7, "key": "reverb", "label": "Reverb", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 20, "cc": 108, "control": "VR7 Main, VR5 FX", "page": "fx"},
        {"id": 8, "key": "reverb_decay", "label": "Reverb decay (own)", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 50, "cc": 109, "control": "VR6 FX", "page": "fx"}
