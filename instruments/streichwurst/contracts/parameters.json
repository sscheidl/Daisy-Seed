        {"id": 1, "key": "registration", "label": "Registration", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 50, "cc": 20, "control": "VR1 Main", "page": "strings"},
        {"id": 2, "key": "octave", "label": "Octaves", "type": "enum", "unit": "none", "min": 0, "max": 2, "default": 0, "cc": 21, "control": "S10", "page": "strings",
         "enum": ["base", "both", "upper"], "enum_labels": ["Base", "Both", "Upper"]},
        {"id": 3, "key": "crescendo", "label": "Crescendo", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 20, "cc": 22, "control": "VR2 Main", "page": "strings"},
        {"id": 4, "key": "release", "label": "Release (strings)", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 45, "cc": 23, "control": "VR3 Main", "page": "strings"},
        {"id": 5, "key": "solo_tone", "label": "Solo Tone", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 50, "cc": 24, "control": "VR1 Solo", "page": "solo"},
