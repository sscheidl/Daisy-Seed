{
  "format_version": 1,
  "note": "Stable parameter IDs and CC plan for Acid Seq (PARAMETERS.md). IDs never change meaning; new parameters get new IDs. Values travel as i32 milli-units (value * 1000).",
  "units": ["none", "percent", "hz", "ms", "db", "semitones", "cents", "bpm", "channel", "velocity"],
  "types": ["float", "int", "enum", "bool"],
  "flags": {"readonly": 1, "log": 2},
  "cc_channel": "voice_channel",
  "components": {
    "step-seq": {
      "schema": 1,
      "parameters": [
        {"id": 1, "key": "tempo", "label": "Tempo", "type": "float", "unit": "bpm", "min": 30, "max": 300, "default": 120, "cc": null, "control": "VR5"},
        {"id": 2, "key": "swing", "label": "Swing", "type": "float", "unit": "percent", "min": 50, "max": 75, "default": 50, "cc": null, "control": "VR6"},
        {"id": 3, "key": "length", "label": "Length", "type": "int", "unit": "none", "min": 1, "max": 16, "default": 16, "cc": null, "control": "VR7"},
        {"id": 4, "key": "transpose", "label": "Transpose", "type": "int", "unit": "semitones", "min": -12, "max": 12, "default": 0, "cc": null, "control": "VR8"},
        {"id": 5, "key": "play_mode", "label": "Mode", "type": "enum", "unit": "none", "min": 0, "max": 2, "default": 0, "cc": null, "control": "SW18", "flags": ["readonly"],
         "enum": ["forward", "reverse", "random"], "enum_labels": ["Forward", "Reverse", "Random"]},
        {"id": 6, "key": "scale", "label": "Scale", "type": "enum", "unit": "none", "min": 0, "max": 2, "default": 0, "cc": null,
         "enum": ["chromatic", "major", "minor"], "enum_labels": ["Chromatic", "Major", "Minor"]},
        {"id": 7, "key": "clock_source", "label": "Clock source", "type": "enum", "unit": "none", "min": 0, "max": 3, "default": 0, "cc": null,
         "enum": ["internal", "gate_in_1", "midi", "auto"], "enum_labels": ["Internal", "Gate IN 1", "MIDI", "Auto"]},
        {"id": 8, "key": "clock_divider", "label": "Clock divider", "type": "enum", "unit": "none", "min": 0, "max": 3, "default": 0, "cc": null,
         "enum": ["step", "ppq2", "ppq4", "ppq24"], "enum_labels": ["1 per step", "2 per quarter", "4 per quarter", "24 per quarter"]},
        {"id": 9, "key": "gate_in_2_mode", "label": "Gate IN 2", "type": "enum", "unit": "none", "min": 0, "max": 1, "default": 0, "cc": null,
         "enum": ["reset", "run"], "enum_labels": ["Reset", "Run"]},
        {"id": 10, "key": "cv_in_1_mode", "label": "CV IN 1", "type": "enum", "unit": "none", "min": 0, "max": 1, "default": 0, "cc": null,
         "enum": ["transpose", "off"], "enum_labels": ["Transpose", "Off"]},
        {"id": 11, "key": "cv_in_2_mode", "label": "CV IN 2", "type": "enum", "unit": "none", "min": 0, "max": 2, "default": 0, "cc": null,
         "enum": ["off", "gate_length", "swing"], "enum_labels": ["Off", "Gate length", "Swing"]},
        {"id": 12, "key": "seq_channel", "label": "Seq channel", "type": "int", "unit": "channel", "min": 1, "max": 16, "default": 1, "cc": null},
        {"id": 13, "key": "voice_channel", "label": "Voice channel", "type": "int", "unit": "channel", "min": 1, "max": 16, "default": 2, "cc": null},
        {"id": 14, "key": "usb_out", "label": "USB out", "type": "bool", "unit": "none", "min": 0, "max": 1, "default": 1, "cc": null},
        {"id": 15, "key": "din_out", "label": "DIN out", "type": "bool", "unit": "none", "min": 0, "max": 1, "default": 1, "cc": null},
        {"id": 16, "key": "accent_velocity", "label": "Accent velocity", "type": "int", "unit": "velocity", "min": 1, "max": 127, "default": 127, "cc": null},
        {"id": 17, "key": "velocity", "label": "Velocity", "type": "int", "unit": "velocity", "min": 1, "max": 127, "default": 100, "cc": null},
        {"id": 18, "key": "glide_time", "label": "Glide time", "type": "float", "unit": "ms", "min": 10, "max": 500, "default": 60, "cc": null},
        {"id": 19, "key": "clock_out", "label": "Send clock", "type": "bool", "unit": "none", "min": 0, "max": 1, "default": 1, "cc": null}
      ]
    },
    "acid-303": {
      "schema": 1,
      "parameters": [
