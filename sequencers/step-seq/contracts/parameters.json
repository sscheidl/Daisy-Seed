        {"id": 2, "key": "tune", "label": "Tuning", "type": "int", "unit": "semitones", "min": -12, "max": 12, "default": 0, "cc": 78},
        {"id": 3, "key": "fine", "label": "Fine", "type": "float", "unit": "cents", "min": -100, "max": 100, "default": 0, "cc": 79},
        {"id": 4, "key": "cutoff", "label": "Cutoff", "type": "float", "unit": "hz", "min": 40, "max": 12000, "default": 800, "cc": 74, "flags": ["log"]},
        {"id": 5, "key": "resonance", "label": "Resonance", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 50, "cc": 71},
        {"id": 6, "key": "env_mod", "label": "Env Mod", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 50, "cc": 76},
        {"id": 7, "key": "decay", "label": "Decay", "type": "float", "unit": "ms", "min": 30, "max": 3000, "default": 300, "cc": 75, "flags": ["log"]},
        {"id": 8, "key": "accent", "label": "Accent", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 50, "cc": 77},
        {"id": 9, "key": "volume", "label": "Volume", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 80, "cc": 7},
        {"id": 10, "key": "slide_time", "label": "Slide time", "type": "float", "unit": "ms", "min": 10, "max": 500, "default": 60, "cc": 5},
        {"id": 11, "key": "slide_mode", "label": "Slide mode", "type": "enum", "unit": "none", "min": 0, "max": 2, "default": 1, "cc": null,
         "enum": ["off", "legato", "always"], "enum_labels": ["Off", "Legato", "Always"]}
      ]
    },
    "drive": {
      "schema": 1,
      "parameters": [
        {"id": 1, "key": "enabled", "label": "Drive on", "type": "bool", "unit": "none", "min": 0, "max": 1, "default": 1, "cc": 20},
        {"id": 2, "key": "curve", "label": "Curve", "type": "enum", "unit": "none", "min": 0, "max": 3, "default": 0, "cc": 21,
         "enum": ["soft", "hard", "tape", "fold"], "enum_labels": ["Soft", "Hard", "Tape", "Fold"]},
        {"id": 3, "key": "drive", "label": "Drive", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 25, "cc": 22},
        {"id": 4, "key": "tone", "label": "Tone", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 70, "cc": 23},
        {"id": 5, "key": "level", "label": "Level", "type": "float", "unit": "db", "min": -24, "max": 12, "default": 0, "cc": 24},
        {"id": 6, "key": "auto_level", "label": "Auto-Level", "type": "bool", "unit": "none", "min": 0, "max": 1, "default": 1, "cc": 25},
        {"id": 7, "key": "compensation", "label": "Compensation", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 100, "cc": 26},
        {"id": 8, "key": "target_offset", "label": "Target offset", "type": "float", "unit": "db", "min": -3, "max": 0, "default": -1.5, "cc": 27}
      ]
    },
    "stereo-delay": {
      "schema": 1,
      "parameters": [
        {"id": 1, "key": "enabled", "label": "Delay on", "type": "bool", "unit": "none", "min": 0, "max": 1, "default": 1, "cc": 102},
        {"id": 2, "key": "mode", "label": "Mode", "type": "enum", "unit": "none", "min": 0, "max": 1, "default": 0, "cc": 103,
         "enum": ["ping_pong", "stereo"], "enum_labels": ["Ping-Pong", "Stereo L/R"]},
        {"id": 3, "key": "time", "label": "Time", "type": "float", "unit": "ms", "min": 10, "max": 2000, "default": 375, "cc": 104, "flags": ["log"]},
        {"id": 4, "key": "sync", "label": "Sync", "type": "bool", "unit": "none", "min": 0, "max": 1, "default": 1, "cc": 105},
        {"id": 5, "key": "note_value", "label": "Note value", "type": "enum", "unit": "none", "min": 0, "max": 17, "default": 8, "cc": 106,
         "enum": ["1/32", "1/32T", "1/32.", "1/16", "1/16T", "1/16.", "1/8", "1/8T", "1/8.", "1/4", "1/4T", "1/4.", "1/2", "1/2T", "1/2.", "1/1", "1/1T", "1/1."],
         "enum_labels": ["1/32", "1/32 T", "1/32 d", "1/16", "1/16 T", "1/16 d", "1/8", "1/8 T", "1/8 d", "1/4", "1/4 T", "1/4 d", "1/2", "1/2 T", "1/2 d", "1/1", "1/1 T", "1/1 d"]},
        {"id": 6, "key": "feedback", "label": "Feedback", "type": "float", "unit": "percent", "min": 0, "max": 95, "default": 40, "cc": 107},
        {"id": 7, "key": "mix", "label": "Dry/Wet", "type": "float", "unit": "percent", "min": 0, "max": 100, "default": 25, "cc": 108},
        {"id": 8, "key": "damping", "label": "Damping", "type": "float", "unit": "hz", "min": 1000, "max": 20000, "default": 6000, "cc": 109, "flags": ["log"]}
