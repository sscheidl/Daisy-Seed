 161:src/pm_catalog.cpp ****                     if(!Expect(':'))
 162:src/pm_catalog.cpp ****                         return false;
 163:src/pm_catalog.cpp ****                 }
 164:src/pm_catalog.cpp ****                 if(!SkipValue(depth + 1))
 165:src/pm_catalog.cpp ****                     return false;
 166:src/pm_catalog.cpp ****                 const int sep = Peek();
 167:src/pm_catalog.cpp ****                 if(sep == ',') {
 168:src/pm_catalog.cpp ****                     ++pos_;
 169:src/pm_catalog.cpp ****                     continue;
 170:src/pm_catalog.cpp ****                 }
 171:src/pm_catalog.cpp ****                 if(sep == close) {
 172:src/pm_catalog.cpp ****                     ++pos_;
 173:src/pm_catalog.cpp ****                     return true;
 174:src/pm_catalog.cpp ****                 }
 175:src/pm_catalog.cpp ****                 return Fail(CatalogError::Syntax);
 176:src/pm_catalog.cpp ****             }
 177:src/pm_catalog.cpp ****         }
 178:src/pm_catalog.cpp ****         if(c == 't') return Literal("true");
 179:src/pm_catalog.cpp ****         if(c == 'f') return Literal("false");
 180:src/pm_catalog.cpp ****         if(c == 'n') return Literal("null");
 181:src/pm_catalog.cpp ****         if(c == '-' || (c >= '0' && c <= '9')) {
