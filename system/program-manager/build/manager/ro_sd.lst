   1:../../common/sd/ro_sd.c **** /* Read-only FatFs disk layer on libDaisy's BSP/HAL for SDMMC1.
   2:../../common/sd/ro_sd.c ****  * Combines the Nebulae bridge (isolated IDMA bounce buffer, short per-transfer
   3:../../common/sd/ro_sd.c ****  * timeout, card check and service hook between transfers) with the Diagnostics
   4:../../common/sd/ro_sd.c ****  * driver (STA_PROTECT, re-initialization per mount, overall time budget).
   5:../../common/sd/ro_sd.c ****  * libDaisy's SD_Driver/ff_gen_drv are not used; no write path exists.
   6:../../common/sd/ro_sd.c ****  */
   7:../../common/sd/ro_sd.c **** #include "ro_sd.h"
