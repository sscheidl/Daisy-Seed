  37:../../common/sd/fatfs/ff.c **** /* Limits and boundaries */
  38:../../common/sd/fatfs/ff.c **** #define MAX_DIR		0x200000		/* Max size of FAT directory (byte) */
  39:../../common/sd/fatfs/ff.c **** #define MAX_DIR_EX	0x10000000		/* Max size of exFAT directory (byte) */
  40:../../common/sd/fatfs/ff.c **** #define MAX_FAT12	0xFF5			/* Max FAT12 clusters (differs from specs, but right for real DOS/Windows
  41:../../common/sd/fatfs/ff.c **** #define MAX_FAT16	0xFFF5			/* Max FAT16 clusters (differs from specs, but right for real DOS/Window
  42:../../common/sd/fatfs/ff.c **** #define MAX_FAT32	0x0FFFFFF5		/* Max FAT32 clusters (not defined in specs, practical limit) */
  43:../../common/sd/fatfs/ff.c **** #define MAX_EXFAT	0x7FFFFFFD		/* Max exFAT clusters (differs from specs, implementation limit) */
  44:../../common/sd/fatfs/ff.c **** #define MIN_EXFAT	0x00000100		/* Min exFAT clusters (Not defined in specs, implementation limit) */
  45:../../common/sd/fatfs/ff.c **** #define MIN_FAT12	32				/* Min FAT12 clusters (Not defined in specs, implementation limit) */
  46:../../common/sd/fatfs/ff.c **** #define MIN_VOLUME	64				/* Min volume sectors (Not defined in specs, implementation limit) */
  47:../../common/sd/fatfs/ff.c **** 
  48:../../common/sd/fatfs/ff.c **** 
  49:../../common/sd/fatfs/ff.c **** /* Character code support macros */
  50:../../common/sd/fatfs/ff.c **** #define IsUpper(c)		((c) >= 'A' && (c) <= 'Z')
  51:../../common/sd/fatfs/ff.c **** #define IsLower(c)		((c) >= 'a' && (c) <= 'z')
  52:../../common/sd/fatfs/ff.c **** #define IsDigit(c)		((c) >= '0' && (c) <= '9')
  53:../../common/sd/fatfs/ff.c **** #define IsSeparator(c)	((c) == '/' || (c) == '\\')
  54:../../common/sd/fatfs/ff.c **** #define IsTerminator(c)	((UINT)(c) < (FF_USE_LFN ? ' ' : '!'))
  55:../../common/sd/fatfs/ff.c **** #define IsSurrogate(c)	((c) >= 0xD800 && (c) <= 0xDFFF)
  56:../../common/sd/fatfs/ff.c **** #define IsSurrogateH(c)	((c) >= 0xD800 && (c) <= 0xDBFF)
  57:../../common/sd/fatfs/ff.c **** #define IsSurrogateL(c)	((c) >= 0xDC00 && (c) <= 0xDFFF)
  58:../../common/sd/fatfs/ff.c **** 
  59:../../common/sd/fatfs/ff.c **** 
  60:../../common/sd/fatfs/ff.c **** /* Additional file access control and file status flags for internal use */
  61:../../common/sd/fatfs/ff.c **** #define FA_SEEKEND	0x20	/* Seek to end of the file on file open */
  62:../../common/sd/fatfs/ff.c **** #define FA_MODIFIED	0x40	/* File has been modified */
  63:../../common/sd/fatfs/ff.c **** #define FA_DIRTY	0x80	/* FIL.buf[] needs to be written-back */
  64:../../common/sd/fatfs/ff.c **** 
  65:../../common/sd/fatfs/ff.c **** 
  66:../../common/sd/fatfs/ff.c **** /* Additional file attribute bits for internal use */
  67:../../common/sd/fatfs/ff.c **** #define AM_VOL		0x08	/* Volume label */
  68:../../common/sd/fatfs/ff.c **** #define AM_LFN		0x0F	/* LFN entry */
  69:../../common/sd/fatfs/ff.c **** #define AM_MASK		0x3F	/* Mask of defined bits in FAT */
  70:../../common/sd/fatfs/ff.c **** #define AM_MASKX	0x37	/* Mask of defined bits in exFAT */
  71:../../common/sd/fatfs/ff.c **** 
  72:../../common/sd/fatfs/ff.c **** 
