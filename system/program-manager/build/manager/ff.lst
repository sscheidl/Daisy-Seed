2388:../../common/sd/fatfs/ff.c **** 						dp->blk_ofs = 0xFFFFFFFF;	/* It has no LFN. */
2389:../../common/sd/fatfs/ff.c **** 					}
2390:../../common/sd/fatfs/ff.c **** 					break;
2391:../../common/sd/fatfs/ff.c **** 				}
2392:../../common/sd/fatfs/ff.c **** 			}
2393:../../common/sd/fatfs/ff.c **** #else		/* Non LFN configuration */
2394:../../common/sd/fatfs/ff.c **** 			if (et != DDEM && et != '.' && attr != AM_LFN && (int)((attr & ~AM_ARC) == AM_VOL) == vol) {	/* 
2395:../../common/sd/fatfs/ff.c **** 				break;
2396:../../common/sd/fatfs/ff.c **** 			}
2397:../../common/sd/fatfs/ff.c **** #endif
2398:../../common/sd/fatfs/ff.c **** 		}
2399:../../common/sd/fatfs/ff.c **** 		res = dir_next(dp, 0);		/* Next entry */
2400:../../common/sd/fatfs/ff.c **** 		if (res != FR_OK) break;
2401:../../common/sd/fatfs/ff.c **** 	}
2402:../../common/sd/fatfs/ff.c **** 
2403:../../common/sd/fatfs/ff.c **** 	if (res != FR_OK) dp->sect = 0;		/* Terminate the read operation on error or EOT */
2404:../../common/sd/fatfs/ff.c **** 	return res;
2405:../../common/sd/fatfs/ff.c **** }
