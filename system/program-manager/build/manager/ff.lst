2225:../../common/sd/fatfs/ff.c **** /* exFAT: Load the object's directory entry block */
2226:../../common/sd/fatfs/ff.c **** /*------------------------------------------------*/
2227:../../common/sd/fatfs/ff.c **** 
2228:../../common/sd/fatfs/ff.c **** static FRESULT load_obj_xdir (
2229:../../common/sd/fatfs/ff.c **** 	DIR* dp,			/* Blank directory object to be used to access containing directory */
2230:../../common/sd/fatfs/ff.c **** 	const FFOBJID* obj	/* Object with its containing directory information */
2231:../../common/sd/fatfs/ff.c **** )
2232:../../common/sd/fatfs/ff.c **** {
2233:../../common/sd/fatfs/ff.c **** 	FRESULT res;
2234:../../common/sd/fatfs/ff.c **** 
2235:../../common/sd/fatfs/ff.c **** 	/* Open object containing directory */
2236:../../common/sd/fatfs/ff.c **** 	dp->obj.fs = obj->fs;
2237:../../common/sd/fatfs/ff.c **** 	dp->obj.sclust = obj->c_scl;
2238:../../common/sd/fatfs/ff.c **** 	dp->obj.stat = (BYTE)obj->c_size;
2239:../../common/sd/fatfs/ff.c **** 	dp->obj.objsize = obj->c_size & 0xFFFFFF00;
2240:../../common/sd/fatfs/ff.c **** 	dp->obj.n_frag = 0;
2241:../../common/sd/fatfs/ff.c **** 	dp->blk_ofs = obj->c_ofs;
2242:../../common/sd/fatfs/ff.c **** 
2243:../../common/sd/fatfs/ff.c **** 	res = dir_sdi(dp, dp->blk_ofs);	/* Goto object's entry block */
2244:../../common/sd/fatfs/ff.c **** 	if (res == FR_OK) {
2245:../../common/sd/fatfs/ff.c **** 		res = load_xdir(dp);		/* Load the object's entry block */
2246:../../common/sd/fatfs/ff.c **** 	}
2247:../../common/sd/fatfs/ff.c **** 	return res;
2248:../../common/sd/fatfs/ff.c **** }
2249:../../common/sd/fatfs/ff.c **** #endif
