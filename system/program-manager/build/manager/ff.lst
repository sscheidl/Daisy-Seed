2254:../../common/sd/fatfs/ff.c **** /* exFAT: Store the directory entry block */
2255:../../common/sd/fatfs/ff.c **** /*----------------------------------------*/
2256:../../common/sd/fatfs/ff.c **** 
2257:../../common/sd/fatfs/ff.c **** static FRESULT store_xdir (
2258:../../common/sd/fatfs/ff.c **** 	DIR* dp				/* Pointer to the directory object */
2259:../../common/sd/fatfs/ff.c **** )
2260:../../common/sd/fatfs/ff.c **** {
2261:../../common/sd/fatfs/ff.c **** 	FRESULT res;
2262:../../common/sd/fatfs/ff.c **** 	UINT nent;
2263:../../common/sd/fatfs/ff.c **** 	BYTE *dirb = dp->obj.fs->dirbuf;	/* Pointer to the entry set 85+C0+C1s */
2264:../../common/sd/fatfs/ff.c **** 
2265:../../common/sd/fatfs/ff.c **** 
2266:../../common/sd/fatfs/ff.c **** 	st_16(dirb + XDIR_SetSum, xdir_sum(dirb));	/* Create check sum */
2267:../../common/sd/fatfs/ff.c **** 
2268:../../common/sd/fatfs/ff.c **** 	/* Store the entry set to the directory */
2269:../../common/sd/fatfs/ff.c **** 	nent = dirb[XDIR_NumSec] + 1;	/* Number of entries */
2270:../../common/sd/fatfs/ff.c **** 	res = dir_sdi(dp, dp->blk_ofs);	/* Top of the entry set */
2271:../../common/sd/fatfs/ff.c **** 	while (res == FR_OK) {
2272:../../common/sd/fatfs/ff.c **** 		/* Set an entry to the directory */
2273:../../common/sd/fatfs/ff.c **** 		res = move_window(dp->obj.fs, dp->sect);
2274:../../common/sd/fatfs/ff.c **** 		if (res != FR_OK) break;
2275:../../common/sd/fatfs/ff.c **** 		memcpy(dp->dir, dirb, SZDIRE);
2276:../../common/sd/fatfs/ff.c **** 		dp->obj.fs->wflag = 1;
2277:../../common/sd/fatfs/ff.c **** 
2278:../../common/sd/fatfs/ff.c **** 		if (--nent == 0) break;	/* All done? */
2279:../../common/sd/fatfs/ff.c **** 		dirb += SZDIRE;
2280:../../common/sd/fatfs/ff.c **** 		res = dir_next(dp, 0);	/* Next entry */
2281:../../common/sd/fatfs/ff.c **** 	}
2282:../../common/sd/fatfs/ff.c **** 	return (res == FR_OK || res == FR_DISK_ERR) ? res : FR_INT_ERR;
2283:../../common/sd/fatfs/ff.c **** }
