1855:../../common/sd/fatfs/ff.c **** 	if (res == FR_NO_FILE) res = FR_DENIED;	/* No directory entry to allocate */
1856:../../common/sd/fatfs/ff.c **** 	return res;
1857:../../common/sd/fatfs/ff.c **** }
