2923:../../common/sd/fatfs/ff.c **** 	} else {					/* Stopped at a separator */
2924:../../common/sd/fatfs/ff.c **** 		while (IsSeparator(*p)) p++;	/* Skip duplicated separators if exist */
2925:../../common/sd/fatfs/ff.c **** 		cf = 0;					/* Next segment may follow */
2926:../../common/sd/fatfs/ff.c **** 		if (IsTerminator(*p)) cf = NS_LAST;	/* Ignore terminating separator */
2927:../../common/sd/fatfs/ff.c **** 	}
2928:../../common/sd/fatfs/ff.c **** 	*path = p;					/* Return pointer to the next segment */
2929:../../common/sd/fatfs/ff.c **** 
