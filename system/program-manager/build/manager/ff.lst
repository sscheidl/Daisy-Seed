1538:../../common/sd/fatfs/ff.c **** /*-----------------------------------------------------------------------*/
1539:../../common/sd/fatfs/ff.c **** /* FAT handling - Stretch a chain or Create a new chain                  */
1540:../../common/sd/fatfs/ff.c **** /*-----------------------------------------------------------------------*/
1541:../../common/sd/fatfs/ff.c **** 
1542:../../common/sd/fatfs/ff.c **** static DWORD create_chain (	/* 0:No free cluster, 1:Internal error, 0xFFFFFFFF:Disk error, >=2:New 
1543:../../common/sd/fatfs/ff.c **** 	FFOBJID* obj,		/* Corresponding object */
1544:../../common/sd/fatfs/ff.c **** 	DWORD clst			/* Cluster# to stretch, 0:Create a new chain */
1545:../../common/sd/fatfs/ff.c **** )
1546:../../common/sd/fatfs/ff.c **** {
1547:../../common/sd/fatfs/ff.c **** 	DWORD cs, ncl, scl;
1548:../../common/sd/fatfs/ff.c **** 	FRESULT res;
1549:../../common/sd/fatfs/ff.c **** 	FATFS *fs = obj->fs;
1550:../../common/sd/fatfs/ff.c **** 
1551:../../common/sd/fatfs/ff.c **** 
1552:../../common/sd/fatfs/ff.c **** 	if (clst == 0) {	/* Create a new chain */
1553:../../common/sd/fatfs/ff.c **** 		scl = fs->last_clst;				/* Suggested cluster to start to find */
1554:../../common/sd/fatfs/ff.c **** 		if (scl == 0 || scl >= fs->n_fatent) scl = 1;
1555:../../common/sd/fatfs/ff.c **** 	}
1556:../../common/sd/fatfs/ff.c **** 	else {				/* Stretch a chain */
1557:../../common/sd/fatfs/ff.c **** 		cs = get_fat(obj, clst);			/* Check the cluster status */
1558:../../common/sd/fatfs/ff.c **** 		if (cs < 2) return 1;				/* Test for insanity */
1559:../../common/sd/fatfs/ff.c **** 		if (cs == 0xFFFFFFFF) return cs;	/* Test for disk error */
1560:../../common/sd/fatfs/ff.c **** 		if (cs < fs->n_fatent) return cs;	/* It is already followed by next cluster */
1561:../../common/sd/fatfs/ff.c **** 		scl = clst;							/* Cluster to start to find */
1562:../../common/sd/fatfs/ff.c **** 	}
1563:../../common/sd/fatfs/ff.c **** 	if (fs->free_clst == 0) return 0;		/* No free cluster */
1564:../../common/sd/fatfs/ff.c **** 
1565:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT
1566:../../common/sd/fatfs/ff.c **** 	if (fs->fs_type == FS_EXFAT) {	/* On the exFAT volume */
1567:../../common/sd/fatfs/ff.c **** 		ncl = find_bitmap(fs, scl, 1);				/* Find a free cluster */
1568:../../common/sd/fatfs/ff.c **** 		if (ncl == 0 || ncl == 0xFFFFFFFF) return ncl;	/* No free cluster or hard error? */
1569:../../common/sd/fatfs/ff.c **** 		res = change_bitmap(fs, ncl, 1, 1);			/* Mark the cluster 'in use' */
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccH1nrpr.s 			page 29


1570:../../common/sd/fatfs/ff.c **** 		if (res == FR_INT_ERR) return 1;
1571:../../common/sd/fatfs/ff.c **** 		if (res == FR_DISK_ERR) return 0xFFFFFFFF;
1572:../../common/sd/fatfs/ff.c **** 		if (clst == 0) {							/* Is it a new chain? */
1573:../../common/sd/fatfs/ff.c **** 			obj->stat = 2;							/* Set status 'contiguous' */
1574:../../common/sd/fatfs/ff.c **** 		} else {									/* It is a stretched chain */
1575:../../common/sd/fatfs/ff.c **** 			if (obj->stat == 2 && ncl != scl + 1) {	/* Is the chain got fragmented? */
1576:../../common/sd/fatfs/ff.c **** 				obj->n_cont = scl - obj->sclust;	/* Set size of the contiguous part */
1577:../../common/sd/fatfs/ff.c **** 				obj->stat = 3;						/* Change status 'just fragmented' */
1578:../../common/sd/fatfs/ff.c **** 			}
1579:../../common/sd/fatfs/ff.c **** 		}
1580:../../common/sd/fatfs/ff.c **** 		if (obj->stat != 2) {	/* Is the file non-contiguous? */
1581:../../common/sd/fatfs/ff.c **** 			if (ncl == clst + 1) {	/* Is the cluster next to previous one? */
1582:../../common/sd/fatfs/ff.c **** 				obj->n_frag = obj->n_frag ? obj->n_frag + 1 : 2;	/* Increment size of last framgent */
1583:../../common/sd/fatfs/ff.c **** 			} else {				/* New fragment */
1584:../../common/sd/fatfs/ff.c **** 				if (obj->n_frag == 0) obj->n_frag = 1;
1585:../../common/sd/fatfs/ff.c **** 				res = fill_last_frag(obj, clst, ncl);	/* Fill last fragment on the FAT and link it to new one *
1586:../../common/sd/fatfs/ff.c **** 				if (res == FR_OK) obj->n_frag = 1;
1587:../../common/sd/fatfs/ff.c **** 			}
1588:../../common/sd/fatfs/ff.c **** 		}
1589:../../common/sd/fatfs/ff.c **** 	} else
1590:../../common/sd/fatfs/ff.c **** #endif
1591:../../common/sd/fatfs/ff.c **** 	{	/* On the FAT/FAT32 volume */
1592:../../common/sd/fatfs/ff.c **** 		ncl = 0;
1593:../../common/sd/fatfs/ff.c **** 		if (scl == clst) {						/* Stretching an existing chain? */
1594:../../common/sd/fatfs/ff.c **** 			ncl = scl + 1;						/* Test if next cluster is free */
1595:../../common/sd/fatfs/ff.c **** 			if (ncl >= fs->n_fatent) ncl = 2;
1596:../../common/sd/fatfs/ff.c **** 			cs = get_fat(obj, ncl);				/* Get next cluster status */
1597:../../common/sd/fatfs/ff.c **** 			if (cs == 1 || cs == 0xFFFFFFFF) return cs;	/* Test for error */
1598:../../common/sd/fatfs/ff.c **** 			if (cs != 0) {						/* Not free? */
1599:../../common/sd/fatfs/ff.c **** 				cs = fs->last_clst;				/* Start at suggested cluster if it is valid */
1600:../../common/sd/fatfs/ff.c **** 				if (cs >= 2 && cs < fs->n_fatent) scl = cs;
1601:../../common/sd/fatfs/ff.c **** 				ncl = 0;
1602:../../common/sd/fatfs/ff.c **** 			}
1603:../../common/sd/fatfs/ff.c **** 		}
1604:../../common/sd/fatfs/ff.c **** 		if (ncl == 0) {	/* The new cluster cannot be contiguous and find another fragment */
1605:../../common/sd/fatfs/ff.c **** 			ncl = scl;	/* Start cluster */
1606:../../common/sd/fatfs/ff.c **** 			for (;;) {
1607:../../common/sd/fatfs/ff.c **** 				ncl++;							/* Next cluster */
1608:../../common/sd/fatfs/ff.c **** 				if (ncl >= fs->n_fatent) {		/* Check wrap-around */
1609:../../common/sd/fatfs/ff.c **** 					ncl = 2;
1610:../../common/sd/fatfs/ff.c **** 					if (ncl > scl) return 0;	/* No free cluster found? */
1611:../../common/sd/fatfs/ff.c **** 				}
1612:../../common/sd/fatfs/ff.c **** 				cs = get_fat(obj, ncl);			/* Get the cluster status */
1613:../../common/sd/fatfs/ff.c **** 				if (cs == 0) break;				/* Found a free cluster? */
1614:../../common/sd/fatfs/ff.c **** 				if (cs == 1 || cs == 0xFFFFFFFF) return cs;	/* Test for error */
1615:../../common/sd/fatfs/ff.c **** 				if (ncl == scl) return 0;		/* No free cluster found? */
1616:../../common/sd/fatfs/ff.c **** 			}
1617:../../common/sd/fatfs/ff.c **** 		}
