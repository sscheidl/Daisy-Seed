 987:../../common/sd/fatfs/ff.c **** 	DIR* dp,	/* Directory object pointing the file to register or increment */
 988:../../common/sd/fatfs/ff.c **** 	int acc		/* Desired access (0:Read, 1:Write, 2:Delete/Rename) */
 989:../../common/sd/fatfs/ff.c **** )
 990:../../common/sd/fatfs/ff.c **** {
 991:../../common/sd/fatfs/ff.c **** 	UINT i;
 992:../../common/sd/fatfs/ff.c **** 
