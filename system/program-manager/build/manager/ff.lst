1288:../../common/sd/fatfs/ff.c **** 			fs->wflag = 1;
1289:../../common/sd/fatfs/ff.c **** 			break;
1290:../../common/sd/fatfs/ff.c **** 
1291:../../common/sd/fatfs/ff.c **** 		case FS_FAT32:
1292:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT
1293:../../common/sd/fatfs/ff.c **** 		case FS_EXFAT:
1294:../../common/sd/fatfs/ff.c **** #endif
1295:../../common/sd/fatfs/ff.c **** 			res = move_window(fs, fs->fatbase + (clst / (SS(fs) / 4)));
1296:../../common/sd/fatfs/ff.c **** 			if (res != FR_OK) break;
