 619:../../common/sd/fatfs/ff.c **** /* Load/Store multi-byte word in the FAT structure                       */
 620:../../common/sd/fatfs/ff.c **** /*-----------------------------------------------------------------------*/
 621:../../common/sd/fatfs/ff.c **** 
 622:../../common/sd/fatfs/ff.c **** static WORD ld_16 (const BYTE* ptr)	/*	 Load a 2-byte little-endian word */
 623:../../common/sd/fatfs/ff.c **** {
 624:../../common/sd/fatfs/ff.c **** 	WORD rv;
 625:../../common/sd/fatfs/ff.c **** 
 626:../../common/sd/fatfs/ff.c **** 	rv = ptr[1];
 627:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[0];
 628:../../common/sd/fatfs/ff.c **** 	return rv;
 629:../../common/sd/fatfs/ff.c **** }
 630:../../common/sd/fatfs/ff.c **** 
 631:../../common/sd/fatfs/ff.c **** static DWORD ld_32 (const BYTE* ptr)	/* Load a 4-byte little-endian word */
 632:../../common/sd/fatfs/ff.c **** {
 633:../../common/sd/fatfs/ff.c **** 	DWORD rv;
 634:../../common/sd/fatfs/ff.c **** 
 635:../../common/sd/fatfs/ff.c **** 	rv = ptr[3];
 636:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[2];
 637:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[1];
 638:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[0];
 639:../../common/sd/fatfs/ff.c **** 	return rv;
 640:../../common/sd/fatfs/ff.c **** }
 641:../../common/sd/fatfs/ff.c **** 
 642:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT
 643:../../common/sd/fatfs/ff.c **** static QWORD ld_64 (const BYTE* ptr)	/* Load an 8-byte little-endian word */
 644:../../common/sd/fatfs/ff.c **** {
 645:../../common/sd/fatfs/ff.c **** 	QWORD rv;
 646:../../common/sd/fatfs/ff.c **** 
 647:../../common/sd/fatfs/ff.c **** 	rv = ptr[7];
 648:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[6];
 649:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[5];
 650:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[4];
 651:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[3];
 652:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[2];
 653:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[1];
 654:../../common/sd/fatfs/ff.c **** 	rv = rv << 8 | ptr[0];
 655:../../common/sd/fatfs/ff.c **** 	return rv;
 656:../../common/sd/fatfs/ff.c **** }
 657:../../common/sd/fatfs/ff.c **** #endif
