2425:../../common/sd/fatfs/ff.c **** 
2426:../../common/sd/fatfs/ff.c **** 	res = dir_sdi(dp, 0);			/* Rewind directory object */
2427:../../common/sd/fatfs/ff.c **** 	if (res != FR_OK) return res;
