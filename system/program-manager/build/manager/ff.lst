2443:../../common/sd/fatfs/ff.c **** 			if (nc == 0 && !fs->lfnbuf[ni]) break;	/* Name matched? */
2444:../../common/sd/fatfs/ff.c **** 		}
2445:../../common/sd/fatfs/ff.c **** 		return res;
2446:../../common/sd/fatfs/ff.c **** 	}
2447:../../common/sd/fatfs/ff.c **** #endif
2448:../../common/sd/fatfs/ff.c **** 	/* On the FAT/FAT32 volume */
