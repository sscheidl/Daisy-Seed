 678:../../common/sd/fatfs/ff.c **** 	*ptr++ = (BYTE)val; val >>= 8;
 679:../../common/sd/fatfs/ff.c **** 	*ptr++ = (BYTE)val; val >>= 8;
 680:../../common/sd/fatfs/ff.c **** 	*ptr++ = (BYTE)val; val >>= 8;
