2351:../../common/sd/fatfs/ff.c **** 		if (res != FR_OK) break;
2352:../../common/sd/fatfs/ff.c **** 		et = dp->dir[DIR_Name];	/* Test for the entry type */
2353:../../common/sd/fatfs/ff.c **** 		if (et == 0) {
