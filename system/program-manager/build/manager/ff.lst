 794:../../common/sd/fatfs/ff.c **** 		wc = (wc << 8) + sb;	/* Make a DBC */
 795:../../common/sd/fatfs/ff.c **** 	}
 796:../../common/sd/fatfs/ff.c **** 	if (wc != 0) {
 797:../../common/sd/fatfs/ff.c **** 		wc = ff_oem2uni(wc, CODEPAGE);	/* ANSI/OEM ==> Unicode */
 798:../../common/sd/fatfs/ff.c **** 		if (wc == 0) return 0xFFFFFFFF;	/* Invalid code? */
 799:../../common/sd/fatfs/ff.c **** 	}
