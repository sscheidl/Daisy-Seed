 808:../../common/sd/fatfs/ff.c **** /* Store a Unicode char in defined API encoding */
 809:../../common/sd/fatfs/ff.c **** static UINT put_utf (	/* Returns number of encoding units written (0:buffer overflow or wrong encod
 810:../../common/sd/fatfs/ff.c **** 	DWORD chr,	/* UTF-16 encoded character (Surrogate pair if >=0x10000) */
 811:../../common/sd/fatfs/ff.c **** 	TCHAR* buf,	/* Output buffer */
 812:../../common/sd/fatfs/ff.c **** 	UINT szb	/* Size of the buffer */
 813:../../common/sd/fatfs/ff.c **** )
 814:../../common/sd/fatfs/ff.c **** {
 815:../../common/sd/fatfs/ff.c **** #if FF_LFN_UNICODE == 1	/* UTF-16 output */
 816:../../common/sd/fatfs/ff.c **** 	WCHAR hs, wc;
 817:../../common/sd/fatfs/ff.c **** 
 818:../../common/sd/fatfs/ff.c **** 	hs = (WCHAR)(chr >> 16);
 819:../../common/sd/fatfs/ff.c **** 	wc = (WCHAR)chr;
 820:../../common/sd/fatfs/ff.c **** 	if (hs == 0) {	/* Single encoding unit? */
 821:../../common/sd/fatfs/ff.c **** 		if (szb < 1 || IsSurrogate(wc)) return 0;	/* Buffer overflow or wrong code? */
 822:../../common/sd/fatfs/ff.c **** 		*buf = wc;
 823:../../common/sd/fatfs/ff.c **** 		return 1;
 824:../../common/sd/fatfs/ff.c **** 	}
 825:../../common/sd/fatfs/ff.c **** 	if (szb < 2 || !IsSurrogateH(hs) || !IsSurrogateL(wc)) return 0;	/* Buffer overflow or wrong surro
