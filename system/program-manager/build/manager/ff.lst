1322:../../common/sd/fatfs/ff.c **** static DWORD find_bitmap (	/* 0:Not found, 2..:Cluster block found, 0xFFFFFFFF:Disk error */
1323:../../common/sd/fatfs/ff.c **** 	FATFS* fs,	/* Filesystem object */
1324:../../common/sd/fatfs/ff.c **** 	DWORD clst,	/* Cluster number to scan from */
1325:../../common/sd/fatfs/ff.c **** 	DWORD ncl	/* Number of contiguous clusters to find (1..) */
1326:../../common/sd/fatfs/ff.c **** )
1327:../../common/sd/fatfs/ff.c **** {
1328:../../common/sd/fatfs/ff.c **** 	BYTE bm, bv;
1329:../../common/sd/fatfs/ff.c **** 	UINT i;
1330:../../common/sd/fatfs/ff.c **** 	DWORD val, scl, ctr;
1331:../../common/sd/fatfs/ff.c **** 
1332:../../common/sd/fatfs/ff.c **** 
1333:../../common/sd/fatfs/ff.c **** 	clst -= 2;	/* The first bit in the bitmap corresponds to cluster #2 */
1334:../../common/sd/fatfs/ff.c **** 	if (clst >= fs->n_fatent - 2) clst = 0;
1335:../../common/sd/fatfs/ff.c **** 	scl = val = clst; ctr = 0;
1336:../../common/sd/fatfs/ff.c **** 	for (;;) {
