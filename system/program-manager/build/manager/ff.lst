 976:../../common/sd/fatfs/ff.c **** 
 977:../../common/sd/fatfs/ff.c **** static int enq_share (void)	/* Check if an entry is available for a new object */
 978:../../common/sd/fatfs/ff.c **** {
 979:../../common/sd/fatfs/ff.c **** 	UINT i;
 980:../../common/sd/fatfs/ff.c **** 
 981:../../common/sd/fatfs/ff.c **** 	for (i = 0; i < FF_FS_LOCK && Files[i].fs; i++) ;	/* Find a free entry */
 982:../../common/sd/fatfs/ff.c **** 	return (i == FF_FS_LOCK) ? 0 : 1;
