 886:../../common/sd/fatfs/ff.c **** 	if (wc == 0 || szb < 1) return 0;	/* Invalid character or buffer overflow? */
 887:../../common/sd/fatfs/ff.c **** 	*buf++ = (TCHAR)wc;					/* Store the character */
 888:../../common/sd/fatfs/ff.c **** 	return 1;
 889:../../common/sd/fatfs/ff.c **** #endif
 890:../../common/sd/fatfs/ff.c **** }
