1844:../../common/sd/fatfs/ff.c **** #else
1845:../../common/sd/fatfs/ff.c **** 			if (dp->dir[DIR_Name] == DDEM || dp->dir[DIR_Name] == 0) {	/* Is the entry free? */
1846:../../common/sd/fatfs/ff.c **** #endif
