2413:../../common/sd/fatfs/ff.c **** /*-----------------------------------------------------------------------*/
2414:../../common/sd/fatfs/ff.c **** 
2415:../../common/sd/fatfs/ff.c **** static FRESULT dir_find (	/* FR_OK(0):succeeded, !=0:error */
2416:../../common/sd/fatfs/ff.c **** 	DIR* dp					/* Pointer to the directory object with the file name */
2417:../../common/sd/fatfs/ff.c **** )
2418:../../common/sd/fatfs/ff.c **** {
