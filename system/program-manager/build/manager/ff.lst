2933:../../common/sd/fatfs/ff.c **** 		lfn[di] = 0;
2934:../../common/sd/fatfs/ff.c **** 		for (i = 0; i < 11; i++) {	/* Create dot name for SFN entry */
2935:../../common/sd/fatfs/ff.c **** 			dp->fn[i] = (i < di) ? '.' : ' ';
2936:../../common/sd/fatfs/ff.c **** 		}
