1444:../../common/sd/fatfs/ff.c **** /* FAT handling - Remove a cluster chain                                 */
1445:../../common/sd/fatfs/ff.c **** /*-----------------------------------------------------------------------*/
1446:../../common/sd/fatfs/ff.c **** 
1447:../../common/sd/fatfs/ff.c **** static FRESULT remove_chain (	/* FR_OK(0):succeeded, !=0:error */
1448:../../common/sd/fatfs/ff.c **** 	FFOBJID* obj,		/* Corresponding object */
1449:../../common/sd/fatfs/ff.c **** 	DWORD clst,			/* Cluster to remove a chain from */
1450:../../common/sd/fatfs/ff.c **** 	DWORD pclst			/* Previous cluster of clst (0 if entire chain) */
1451:../../common/sd/fatfs/ff.c **** )
1452:../../common/sd/fatfs/ff.c **** {
1453:../../common/sd/fatfs/ff.c **** 	FRESULT res = FR_OK;
1454:../../common/sd/fatfs/ff.c **** 	DWORD nxt;
1455:../../common/sd/fatfs/ff.c **** 	FATFS *fs = obj->fs;
