1342:../../common/sd/fatfs/ff.c **** 				if (++val >= fs->n_fatent - 2) {	/* Next cluster (with wrap-around) */
1343:../../common/sd/fatfs/ff.c **** 					val = 0; bm = 0; i = SS(fs);
1344:../../common/sd/fatfs/ff.c **** 				}
1345:../../common/sd/fatfs/ff.c **** 				if (bv == 0) {	/* Is it a free cluster? */
1346:../../common/sd/fatfs/ff.c **** 					if (++ctr == ncl) return scl + 2;	/* Check if run length is sufficient for required */
1347:../../common/sd/fatfs/ff.c **** 				} else {
1348:../../common/sd/fatfs/ff.c **** 					scl = val; ctr = 0;		/* Encountered a cluster in-use, restart to scan */
1349:../../common/sd/fatfs/ff.c **** 				}
1350:../../common/sd/fatfs/ff.c **** 				if (val == clst) return 0;	/* All cluster scanned? */
1351:../../common/sd/fatfs/ff.c **** 			} while (bm != 0);
1352:../../common/sd/fatfs/ff.c **** 			bm = 1;
1353:../../common/sd/fatfs/ff.c **** 		} while (++i < SS(fs));
1354:../../common/sd/fatfs/ff.c **** 	}
1355:../../common/sd/fatfs/ff.c **** }
1356:../../common/sd/fatfs/ff.c **** 
1357:../../common/sd/fatfs/ff.c **** 
1358:../../common/sd/fatfs/ff.c **** /*----------------------------------------*/
1359:../../common/sd/fatfs/ff.c **** /* Set/Clear a block of allocation bitmap */
1360:../../common/sd/fatfs/ff.c **** /*----------------------------------------*/
1361:../../common/sd/fatfs/ff.c **** 
1362:../../common/sd/fatfs/ff.c **** static FRESULT change_bitmap (
1363:../../common/sd/fatfs/ff.c **** 	FATFS* fs,	/* Filesystem object */
1364:../../common/sd/fatfs/ff.c **** 	DWORD clst,	/* Cluster number to change from */
1365:../../common/sd/fatfs/ff.c **** 	DWORD ncl,	/* Number of clusters to be changed */
1366:../../common/sd/fatfs/ff.c **** 	int bv		/* bit value to be set (0 or 1) */
1367:../../common/sd/fatfs/ff.c **** )
1368:../../common/sd/fatfs/ff.c **** {
1369:../../common/sd/fatfs/ff.c **** 	BYTE bm;
1370:../../common/sd/fatfs/ff.c **** 	UINT i;
1371:../../common/sd/fatfs/ff.c **** 	LBA_t sect;
1372:../../common/sd/fatfs/ff.c **** 
1373:../../common/sd/fatfs/ff.c **** 
1374:../../common/sd/fatfs/ff.c **** 	clst -= 2;	/* The first bit corresponds to cluster #2 */
1375:../../common/sd/fatfs/ff.c **** 	sect = fs->bitbase + clst / 8 / SS(fs);	/* Sector address */
1376:../../common/sd/fatfs/ff.c **** 	i = clst / 8 % SS(fs);					/* Byte offset in the sector */
1377:../../common/sd/fatfs/ff.c **** 	bm = 1 << (clst % 8);					/* Bit mask in the byte */
1378:../../common/sd/fatfs/ff.c **** 	for (;;) {
1379:../../common/sd/fatfs/ff.c **** 		if (move_window(fs, sect++) != FR_OK) return FR_DISK_ERR;
1380:../../common/sd/fatfs/ff.c **** 		do {
1381:../../common/sd/fatfs/ff.c **** 			do {
1382:../../common/sd/fatfs/ff.c **** 				if (bv == (int)((fs->win[i] & bm) != 0)) return FR_INT_ERR;	/* Is the bit expected value? */
1383:../../common/sd/fatfs/ff.c **** 				fs->win[i] ^= bm;	/* Flip the bit */
1384:../../common/sd/fatfs/ff.c **** 				fs->wflag = 1;
1385:../../common/sd/fatfs/ff.c **** 				if (--ncl == 0) return FR_OK;	/* All bits processed? */
1386:../../common/sd/fatfs/ff.c **** 			} while (bm <<= 1);		/* Next bit */
1387:../../common/sd/fatfs/ff.c **** 			bm = 1;
1388:../../common/sd/fatfs/ff.c **** 		} while (++i < SS(fs));		/* Next byte */
1389:../../common/sd/fatfs/ff.c **** 		i = 0;
1390:../../common/sd/fatfs/ff.c **** 	}
1391:../../common/sd/fatfs/ff.c **** }
1392:../../common/sd/fatfs/ff.c **** 
1393:../../common/sd/fatfs/ff.c **** 
1394:../../common/sd/fatfs/ff.c **** /*---------------------------------------------*/
1395:../../common/sd/fatfs/ff.c **** /* Fill the first fragment of the FAT chain    */
1396:../../common/sd/fatfs/ff.c **** /*---------------------------------------------*/
1397:../../common/sd/fatfs/ff.c **** 
1398:../../common/sd/fatfs/ff.c **** static FRESULT fill_first_frag (
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccH1nrpr.s 			page 26


1399:../../common/sd/fatfs/ff.c **** 	FFOBJID* obj	/* Pointer to the corresponding object */
1400:../../common/sd/fatfs/ff.c **** )
1401:../../common/sd/fatfs/ff.c **** {
1402:../../common/sd/fatfs/ff.c **** 	FRESULT res;
1403:../../common/sd/fatfs/ff.c **** 	DWORD cl, n;
1404:../../common/sd/fatfs/ff.c **** 
1405:../../common/sd/fatfs/ff.c **** 
1406:../../common/sd/fatfs/ff.c **** 	if (obj->stat == 3) {	/* Has the object been changed 'fragmented' in this session? */
1407:../../common/sd/fatfs/ff.c **** 		for (cl = obj->sclust, n = obj->n_cont; n; cl++, n--) {	/* Create cluster chain on the FAT */
1408:../../common/sd/fatfs/ff.c **** 			res = put_fat(obj->fs, cl, cl + 1);
1409:../../common/sd/fatfs/ff.c **** 			if (res != FR_OK) return res;
1410:../../common/sd/fatfs/ff.c **** 		}
1411:../../common/sd/fatfs/ff.c **** 		obj->stat = 0;	/* Change status 'FAT chain is valid' */
1412:../../common/sd/fatfs/ff.c **** 	}
1413:../../common/sd/fatfs/ff.c **** 	return FR_OK;
1414:../../common/sd/fatfs/ff.c **** }
