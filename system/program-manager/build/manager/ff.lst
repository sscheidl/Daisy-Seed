 950:../../common/sd/fatfs/ff.c **** static FRESULT chk_share (	/* Check if the file can be accessed */
 951:../../common/sd/fatfs/ff.c **** 	DIR* dp,		/* Directory object pointing the file to be checked */
 952:../../common/sd/fatfs/ff.c **** 	int acc			/* Desired access type (0:Read mode open, 1:Write mode open, 2:Delete or rename) */
 953:../../common/sd/fatfs/ff.c **** )
 954:../../common/sd/fatfs/ff.c **** {
 955:../../common/sd/fatfs/ff.c **** 	UINT i, be;
 956:../../common/sd/fatfs/ff.c **** 
 957:../../common/sd/fatfs/ff.c **** 	/* Search open object table for the object */
 958:../../common/sd/fatfs/ff.c **** 	be = 0;
 959:../../common/sd/fatfs/ff.c **** 	for (i = 0; i < FF_FS_LOCK; i++) {
 960:../../common/sd/fatfs/ff.c **** 		if (Files[i].fs) {	/* Existing entry */
 961:../../common/sd/fatfs/ff.c **** 			if (Files[i].fs == dp->obj.fs &&	 	/* Check if the object matches with an open object */
 962:../../common/sd/fatfs/ff.c **** 				Files[i].clu == dp->obj.sclust &&
 963:../../common/sd/fatfs/ff.c **** 				Files[i].ofs == dp->dptr) break;
 964:../../common/sd/fatfs/ff.c **** 		} else {			/* Blank entry */
 965:../../common/sd/fatfs/ff.c **** 			be = 1;
 966:../../common/sd/fatfs/ff.c **** 		}
 967:../../common/sd/fatfs/ff.c **** 	}
 968:../../common/sd/fatfs/ff.c **** 	if (i == FF_FS_LOCK) {	/* The object has not been opened */
 969:../../common/sd/fatfs/ff.c **** 		return (!be && acc != 2) ? FR_TOO_MANY_OPEN_FILES : FR_OK;	/* Is there a blank entry for new obje
 970:../../common/sd/fatfs/ff.c **** 	}
 971:../../common/sd/fatfs/ff.c **** 
 972:../../common/sd/fatfs/ff.c **** 	/* The object was opened. Reject any open against writing file and all write mode open */
 973:../../common/sd/fatfs/ff.c **** 	return (acc != 0 || Files[i].ctr == 0x100) ? FR_LOCKED : FR_OK;
 974:../../common/sd/fatfs/ff.c **** }
