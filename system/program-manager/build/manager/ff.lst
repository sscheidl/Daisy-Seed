2191:../../common/sd/fatfs/ff.c **** 		if (xdir_sum(dirb) != ld_16(dirb + XDIR_SetSum)) return FR_INT_ERR;
2192:../../common/sd/fatfs/ff.c **** 	}
2193:../../common/sd/fatfs/ff.c **** 
2194:../../common/sd/fatfs/ff.c **** 	return FR_OK;
