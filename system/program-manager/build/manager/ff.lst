2370:../../common/sd/fatfs/ff.c **** 		} else
2371:../../common/sd/fatfs/ff.c **** #endif
2372:../../common/sd/fatfs/ff.c **** 		{	/* On the FAT/FAT32 volume */
2373:../../common/sd/fatfs/ff.c **** 			dp->obj.attr = attr = dp->dir[DIR_Attr] & AM_MASK;	/* Get attribute */
2374:../../common/sd/fatfs/ff.c **** #if FF_USE_LFN		/* LFN configuration */
