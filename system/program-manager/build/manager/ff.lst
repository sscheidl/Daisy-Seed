  80:../../common/sd/fatfs/ff.c **** #define NS_DOT		0x20	/* Dot entry */
  81:../../common/sd/fatfs/ff.c **** #define NS_NOLFN	0x40	/* Do not find LFN */
  82:../../common/sd/fatfs/ff.c **** #define NS_NONAME	0x80	/* Not followed */
