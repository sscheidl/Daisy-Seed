 882:../../common/sd/fatfs/ff.c **** 		*buf++ = (char)(wc >> 8);	/* Store DBC 1st byte */
 883:../../common/sd/fatfs/ff.c **** 		*buf++ = (TCHAR)wc;			/* Store DBC 2nd byte */
