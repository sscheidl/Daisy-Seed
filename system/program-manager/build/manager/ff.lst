2290:../../common/sd/fatfs/ff.c **** 
2291:../../common/sd/fatfs/ff.c **** static void create_xdir (
2292:../../common/sd/fatfs/ff.c **** 	BYTE* dirb,			/* Pointer to the directory entry block buffer */
2293:../../common/sd/fatfs/ff.c **** 	const WCHAR* lfn	/* Pointer to the object name */
2294:../../common/sd/fatfs/ff.c **** )
2295:../../common/sd/fatfs/ff.c **** {
2296:../../common/sd/fatfs/ff.c **** 	UINT i;
2297:../../common/sd/fatfs/ff.c **** 	BYTE n_c1, nlen;
2298:../../common/sd/fatfs/ff.c **** 	WCHAR chr;
2299:../../common/sd/fatfs/ff.c **** 
2300:../../common/sd/fatfs/ff.c **** 
2301:../../common/sd/fatfs/ff.c **** 	/* Create file-directory and stream-extension entry (1st and 2nd entry) */
2302:../../common/sd/fatfs/ff.c **** 	memset(dirb, 0, 2 * SZDIRE);
2303:../../common/sd/fatfs/ff.c **** 	dirb[0 * SZDIRE + XDIR_Type] = ET_FILEDIR;
2304:../../common/sd/fatfs/ff.c **** 	dirb[1 * SZDIRE + XDIR_Type] = ET_STREAM;
2305:../../common/sd/fatfs/ff.c **** 
2306:../../common/sd/fatfs/ff.c **** 	/* Create file name entries (3rd enrty and follows) */
2307:../../common/sd/fatfs/ff.c **** 	i = SZDIRE * 2;	/* Top of file name entries */
2308:../../common/sd/fatfs/ff.c **** 	nlen = n_c1 = 0; chr = 1;
2309:../../common/sd/fatfs/ff.c **** 	do {
2310:../../common/sd/fatfs/ff.c **** 		dirb[i++] = ET_FILENAME; dirb[i++] = 0;
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccH1nrpr.s 			page 42


2311:../../common/sd/fatfs/ff.c **** 		do {	/* Fill name field */
2312:../../common/sd/fatfs/ff.c **** 			if (chr != 0 && (chr = lfn[nlen]) != 0) nlen++;	/* Get a character if exist */
2313:../../common/sd/fatfs/ff.c **** 			st_16(dirb + i, chr); 	/* Store it */
2314:../../common/sd/fatfs/ff.c **** 			i += 2;
2315:../../common/sd/fatfs/ff.c **** 		} while (i % SZDIRE != 0);
2316:../../common/sd/fatfs/ff.c **** 		n_c1++;
