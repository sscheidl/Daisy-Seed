2200:../../common/sd/fatfs/ff.c **** /*------------------------------------------------------------------*/
2201:../../common/sd/fatfs/ff.c **** 
2202:../../common/sd/fatfs/ff.c **** static void init_alloc_info (
2203:../../common/sd/fatfs/ff.c **** 	FFOBJID* dobj,	/* Object allocation information to be initialized */
2204:../../common/sd/fatfs/ff.c **** 	DIR* sdir		/* Additional source about containing direcotry */
2205:../../common/sd/fatfs/ff.c **** )
2206:../../common/sd/fatfs/ff.c **** {
2207:../../common/sd/fatfs/ff.c **** 	FATFS *fs = dobj->fs;
2208:../../common/sd/fatfs/ff.c **** 
2209:../../common/sd/fatfs/ff.c **** 
2210:../../common/sd/fatfs/ff.c **** 	if (sdir) {	/* Initialize the containing directory. This block needs to precede the followings. */
2211:../../common/sd/fatfs/ff.c **** 		dobj->c_scl = sdir->obj.sclust;
2212:../../common/sd/fatfs/ff.c **** 		dobj->c_size = ((DWORD)sdir->obj.objsize & 0xFFFFFF00) | sdir->obj.stat;
2213:../../common/sd/fatfs/ff.c **** 		dobj->c_ofs = sdir->blk_ofs;
2214:../../common/sd/fatfs/ff.c **** 	}
2215:../../common/sd/fatfs/ff.c **** 	dobj->sclust = ld_32(fs->dirbuf + XDIR_FstClus);	/* Start cluster */
2216:../../common/sd/fatfs/ff.c **** 	dobj->objsize = ld_64(fs->dirbuf + XDIR_FileSize);	/* Size */
2217:../../common/sd/fatfs/ff.c **** 	dobj->stat = fs->dirbuf[XDIR_GenFlags] & 2;			/* Allocation status */
2218:../../common/sd/fatfs/ff.c **** 	dobj->n_frag = 0;									/* No last fragment info */
2219:../../common/sd/fatfs/ff.c **** }
