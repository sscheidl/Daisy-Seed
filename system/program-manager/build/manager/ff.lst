4372:../../common/sd/fatfs/ff.c **** 	res = mount_volume(&path, &fs, 0);	/* Get logical drive and mount the volume if needed */
4373:../../common/sd/fatfs/ff.c **** 	if (res == FR_OK) {
4374:../../common/sd/fatfs/ff.c **** 		dj.obj.fs = fs;
