4378:../../common/sd/fatfs/ff.c **** 			if (dj.fn[NSFLAG] & NS_NONAME) {	/* Is it the start directory itself? */
4379:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT
4380:../../common/sd/fatfs/ff.c **** 				if (fs->fs_type == FS_EXFAT) {
4381:../../common/sd/fatfs/ff.c **** 					memcpy(&fs->xcwds, &fs->xcwds2, sizeof fs->xcwds);
