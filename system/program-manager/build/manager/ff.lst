 875:../../common/sd/fatfs/ff.c **** 
 876:../../common/sd/fatfs/ff.c **** #else						/* ANSI/OEM output */
 877:../../common/sd/fatfs/ff.c **** 	WCHAR wc;
 878:../../common/sd/fatfs/ff.c **** 
 879:../../common/sd/fatfs/ff.c **** 	wc = ff_uni2oem(chr, CODEPAGE);
