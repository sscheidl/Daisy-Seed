1456:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT || FF_USE_TRIM
1457:../../common/sd/fatfs/ff.c **** 	DWORD scl = clst, ecl = clst;
1458:../../common/sd/fatfs/ff.c **** #endif
1459:../../common/sd/fatfs/ff.c **** #if FF_USE_TRIM
1460:../../common/sd/fatfs/ff.c **** 	LBA_t rt[2];
1461:../../common/sd/fatfs/ff.c **** #endif
1462:../../common/sd/fatfs/ff.c **** 
1463:../../common/sd/fatfs/ff.c **** 	if (clst < 2 || clst >= fs->n_fatent) return FR_INT_ERR;	/* Check if in valid range */
1464:../../common/sd/fatfs/ff.c **** 
1465:../../common/sd/fatfs/ff.c **** 	/* Mark the previous cluster 'EOC' on the FAT if it exists */
1466:../../common/sd/fatfs/ff.c **** 	if (pclst != 0 && (!FF_FS_EXFAT || fs->fs_type != FS_EXFAT || obj->stat != 2)) {
1467:../../common/sd/fatfs/ff.c **** 		res = put_fat(fs, pclst, 0xFFFFFFFF);
1468:../../common/sd/fatfs/ff.c **** 		if (res != FR_OK) return res;
1469:../../common/sd/fatfs/ff.c **** 	}
1470:../../common/sd/fatfs/ff.c **** 
1471:../../common/sd/fatfs/ff.c **** 	/* Remove the chain */
1472:../../common/sd/fatfs/ff.c **** 	do {
1473:../../common/sd/fatfs/ff.c **** 		nxt = get_fat(obj, clst);			/* Get cluster status */
1474:../../common/sd/fatfs/ff.c **** 		if (nxt == 0) break;				/* Empty cluster? */
1475:../../common/sd/fatfs/ff.c **** 		if (nxt == 1) return FR_INT_ERR;	/* Internal error? */
1476:../../common/sd/fatfs/ff.c **** 		if (nxt == 0xFFFFFFFF) return FR_DISK_ERR;	/* Disk error? */
1477:../../common/sd/fatfs/ff.c **** 		if (!FF_FS_EXFAT || fs->fs_type != FS_EXFAT) {
1478:../../common/sd/fatfs/ff.c **** 			res = put_fat(fs, clst, 0);		/* Mark the cluster 'free' on the FAT */
1479:../../common/sd/fatfs/ff.c **** 			if (res != FR_OK) return res;
1480:../../common/sd/fatfs/ff.c **** 		}
1481:../../common/sd/fatfs/ff.c **** 		if (fs->free_clst < fs->n_fatent - 2) {	/* Update allocation information if it is valid */
1482:../../common/sd/fatfs/ff.c **** 			fs->free_clst++;
1483:../../common/sd/fatfs/ff.c **** 			fs->fsi_flag |= 1;
1484:../../common/sd/fatfs/ff.c **** 		}
1485:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT || FF_USE_TRIM
1486:../../common/sd/fatfs/ff.c **** 		if (ecl + 1 == nxt) {	/* Is next cluster contiguous? */
1487:../../common/sd/fatfs/ff.c **** 			ecl = nxt;
1488:../../common/sd/fatfs/ff.c **** 		} else {				/* End of contiguous cluster block */
1489:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT
1490:../../common/sd/fatfs/ff.c **** 			if (fs->fs_type == FS_EXFAT) {
1491:../../common/sd/fatfs/ff.c **** 				res = change_bitmap(fs, scl, ecl - scl + 1, 0);	/* Mark the cluster block 'free' on the bitmap 
1492:../../common/sd/fatfs/ff.c **** 				if (res != FR_OK) return res;
1493:../../common/sd/fatfs/ff.c **** 			}
1494:../../common/sd/fatfs/ff.c **** #endif
1495:../../common/sd/fatfs/ff.c **** #if FF_USE_TRIM
1496:../../common/sd/fatfs/ff.c **** 			rt[0] = clst2sect(fs, scl);					/* Start of data area to be freed */
1497:../../common/sd/fatfs/ff.c **** 			rt[1] = clst2sect(fs, ecl) + fs->csize - 1;	/* End of data area to be freed */
1498:../../common/sd/fatfs/ff.c **** 			disk_ioctl(fs->pdrv, CTRL_TRIM, rt);		/* Inform storage device that the data in the block may be
1499:../../common/sd/fatfs/ff.c **** #endif
1500:../../common/sd/fatfs/ff.c **** 			scl = ecl = nxt;
1501:../../common/sd/fatfs/ff.c **** 		}
1502:../../common/sd/fatfs/ff.c **** #endif
1503:../../common/sd/fatfs/ff.c **** 		clst = nxt;					/* Next cluster */
1504:../../common/sd/fatfs/ff.c **** 	} while (clst < fs->n_fatent);	/* Repeat until the last link */
1505:../../common/sd/fatfs/ff.c **** 
1506:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT
1507:../../common/sd/fatfs/ff.c **** 	/* Some post processes for chain status */
1508:../../common/sd/fatfs/ff.c **** 	if (fs->fs_type == FS_EXFAT) {
1509:../../common/sd/fatfs/ff.c **** 		if (pclst == 0) {	/* Has the entire chain been removed? */
1510:../../common/sd/fatfs/ff.c **** 			obj->stat = 0;		/* Change the chain status 'initial' */
1511:../../common/sd/fatfs/ff.c **** 		} else {
1512:../../common/sd/fatfs/ff.c **** 			if (obj->stat == 0) {	/* Is it a fragmented chain from the beginning of this session? */
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccH1nrpr.s 			page 28


1513:../../common/sd/fatfs/ff.c **** 				clst = obj->sclust;		/* Follow the chain to check if it gets contiguous */
1514:../../common/sd/fatfs/ff.c **** 				while (clst != pclst) {
1515:../../common/sd/fatfs/ff.c **** 					nxt = get_fat(obj, clst);
1516:../../common/sd/fatfs/ff.c **** 					if (nxt < 2) return FR_INT_ERR;
1517:../../common/sd/fatfs/ff.c **** 					if (nxt == 0xFFFFFFFF) return FR_DISK_ERR;
1518:../../common/sd/fatfs/ff.c **** 					if (nxt != clst + 1) break;	/* Not contiguous? */
1519:../../common/sd/fatfs/ff.c **** 					clst++;
1520:../../common/sd/fatfs/ff.c **** 				}
1521:../../common/sd/fatfs/ff.c **** 				if (clst == pclst) {	/* Has the chain got contiguous again? */
1522:../../common/sd/fatfs/ff.c **** 					obj->stat = 2;		/* Change the chain status 'contiguous' */
1523:../../common/sd/fatfs/ff.c **** 				}
1524:../../common/sd/fatfs/ff.c **** 			} else {
1525:../../common/sd/fatfs/ff.c **** 				if (obj->stat == 3 && pclst >= obj->sclust && pclst <= obj->sclust + obj->n_cont) {	/* Was the 
1526:../../common/sd/fatfs/ff.c **** 					obj->stat = 2;	/* Change the chain status 'contiguous' */
1527:../../common/sd/fatfs/ff.c **** 				}
1528:../../common/sd/fatfs/ff.c **** 			}
1529:../../common/sd/fatfs/ff.c **** 		}
1530:../../common/sd/fatfs/ff.c **** 	}
1531:../../common/sd/fatfs/ff.c **** #endif
1532:../../common/sd/fatfs/ff.c **** 	return FR_OK;
1533:../../common/sd/fatfs/ff.c **** }
