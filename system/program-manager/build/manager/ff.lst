 859:../../common/sd/fatfs/ff.c **** 	*buf++ = (TCHAR)(0x80 | (chr >> 6 & 0x3F));
 860:../../common/sd/fatfs/ff.c **** 	*buf++ = (TCHAR)(0x80 | (chr >> 0 & 0x3F));
 861:../../common/sd/fatfs/ff.c **** 	return 4;
 862:../../common/sd/fatfs/ff.c **** 
 863:../../common/sd/fatfs/ff.c **** #elif FF_LFN_UNICODE == 3	/* UTF-32 output */
 864:../../common/sd/fatfs/ff.c **** 	DWORD hc;
 865:../../common/sd/fatfs/ff.c **** 
 866:../../common/sd/fatfs/ff.c **** 	if (szb < 1) return 0;	/* Buffer overflow? */
 867:../../common/sd/fatfs/ff.c **** 	if (chr >= 0x10000) {	/* Out of BMP? */
 868:../../common/sd/fatfs/ff.c **** 		hc = ((chr & 0xFFFF0000) - 0xD8000000) >> 6;	/* Get high 10 bits */
 869:../../common/sd/fatfs/ff.c **** 		chr = (chr & 0xFFFF) - 0xDC00;					/* Get low 10 bits */
 870:../../common/sd/fatfs/ff.c **** 		if (hc >= 0x100000 || chr >= 0x400) return 0;	/* Wrong surrogate? */
 871:../../common/sd/fatfs/ff.c **** 		chr = (hc | chr) + 0x10000;
