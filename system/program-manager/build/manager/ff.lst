2841:../../common/sd/fatfs/ff.c **** static int pattern_match (	/* 0:mismatched, 1:matched */
2842:../../common/sd/fatfs/ff.c **** 	const TCHAR* pat,	/* Matching pattern */
2843:../../common/sd/fatfs/ff.c **** 	const TCHAR* nam,	/* String to be tested */
2844:../../common/sd/fatfs/ff.c **** 	UINT skip,			/* Number of pre-skip chars (number of ?s, b8:infinite (* specified)) */
2845:../../common/sd/fatfs/ff.c **** 	UINT recur			/* Recursion count */
2846:../../common/sd/fatfs/ff.c **** )
2847:../../common/sd/fatfs/ff.c **** {
2848:../../common/sd/fatfs/ff.c **** 	const TCHAR *pptr;
2849:../../common/sd/fatfs/ff.c **** 	const TCHAR *nptr;
2850:../../common/sd/fatfs/ff.c **** 	DWORD pchr, nchr;
2851:../../common/sd/fatfs/ff.c **** 	UINT sk;
2852:../../common/sd/fatfs/ff.c **** 
2853:../../common/sd/fatfs/ff.c **** 
2854:../../common/sd/fatfs/ff.c **** 	while ((skip & 0xFF) != 0) {		/* Pre-skip name chars */
2855:../../common/sd/fatfs/ff.c **** 		if (!get_achar(&nam)) return 0;	/* Branch mismatched if less name chars */
2856:../../common/sd/fatfs/ff.c **** 		skip--;
2857:../../common/sd/fatfs/ff.c **** 	}
2858:../../common/sd/fatfs/ff.c **** 	if (*pat == 0 && skip) return 1;	/* Matched? (short circuit) */
2859:../../common/sd/fatfs/ff.c **** 
2860:../../common/sd/fatfs/ff.c **** 	do {
2861:../../common/sd/fatfs/ff.c **** 		pptr = pat; nptr = nam;			/* Top of pattern and name to match */
2862:../../common/sd/fatfs/ff.c **** 		for (;;) {
2863:../../common/sd/fatfs/ff.c **** 			if (*pptr == '\?' || *pptr == '*') {	/* Wildcard term? */
2864:../../common/sd/fatfs/ff.c **** 				if (recur == 0) return 0;	/* Too many wildcard terms? */
2865:../../common/sd/fatfs/ff.c **** 				sk = 0;
2866:../../common/sd/fatfs/ff.c **** 				do {	/* Analyze the wildcard term */
2867:../../common/sd/fatfs/ff.c **** 					if (*pptr++ == '\?') {
2868:../../common/sd/fatfs/ff.c **** 						sk++;
2869:../../common/sd/fatfs/ff.c **** 					} else {
2870:../../common/sd/fatfs/ff.c **** 						sk |= 0x100;
2871:../../common/sd/fatfs/ff.c **** 					}
2872:../../common/sd/fatfs/ff.c **** 				} while (*pptr == '\?' || *pptr == '*');
2873:../../common/sd/fatfs/ff.c **** 				if (pattern_match(pptr, nptr, sk, recur - 1)) return 1;	/* Test new branch (recursive call) */
2874:../../common/sd/fatfs/ff.c **** 				nchr = *nptr; break;	/* Branch mismatched */
2875:../../common/sd/fatfs/ff.c **** 			}
2876:../../common/sd/fatfs/ff.c **** 			pchr = get_achar(&pptr);	/* Get a pattern char */
2877:../../common/sd/fatfs/ff.c **** 			nchr = get_achar(&nptr);	/* Get a name char */
2878:../../common/sd/fatfs/ff.c **** 			if (pchr != nchr) break;	/* Branch mismatched? */
2879:../../common/sd/fatfs/ff.c **** 			if (pchr == 0) return 1;	/* Branch matched? (matched at end of both strings) */
2880:../../common/sd/fatfs/ff.c **** 		}
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccH1nrpr.s 			page 52


2881:../../common/sd/fatfs/ff.c **** 		get_achar(&nam);			/* nam++ */
2882:../../common/sd/fatfs/ff.c **** 	} while (skip && nchr);		/* Retry until end of name if infinite search is specified */
2883:../../common/sd/fatfs/ff.c **** 
2884:../../common/sd/fatfs/ff.c **** 	return 0;
2885:../../common/sd/fatfs/ff.c **** }
