1416:../../common/sd/fatfs/ff.c **** 
1417:../../common/sd/fatfs/ff.c **** /*---------------------------------------------*/
1418:../../common/sd/fatfs/ff.c **** /* Fill the last fragment of the FAT chain     */
1419:../../common/sd/fatfs/ff.c **** /*---------------------------------------------*/
1420:../../common/sd/fatfs/ff.c **** 
1421:../../common/sd/fatfs/ff.c **** static FRESULT fill_last_frag (
1422:../../common/sd/fatfs/ff.c **** 	FFOBJID* obj,	/* Pointer to the corresponding object */
1423:../../common/sd/fatfs/ff.c **** 	DWORD lcl,		/* Last cluster of the fragment */
1424:../../common/sd/fatfs/ff.c **** 	DWORD term		/* Value to set the last FAT entry */
1425:../../common/sd/fatfs/ff.c **** )
1426:../../common/sd/fatfs/ff.c **** {
1427:../../common/sd/fatfs/ff.c **** 	FRESULT res;
1428:../../common/sd/fatfs/ff.c **** 
1429:../../common/sd/fatfs/ff.c **** 
1430:../../common/sd/fatfs/ff.c **** 	while (obj->n_frag > 0) {	/* Create the chain of last fragment */
1431:../../common/sd/fatfs/ff.c **** 		res = put_fat(obj->fs, lcl - obj->n_frag + 1, (obj->n_frag > 1) ? lcl - obj->n_frag + 2 : term);
1432:../../common/sd/fatfs/ff.c **** 		if (res != FR_OK) return res;
1433:../../common/sd/fatfs/ff.c **** 		obj->n_frag--;
1434:../../common/sd/fatfs/ff.c **** 	}
1435:../../common/sd/fatfs/ff.c **** 	return FR_OK;
1436:../../common/sd/fatfs/ff.c **** }
