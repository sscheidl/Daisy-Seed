2983:../../common/sd/fatfs/ff.c **** 			}
2984:../../common/sd/fatfs/ff.c **** #elif FF_CODE_PAGE < 900	/* In SBCS cfg */
2985:../../common/sd/fatfs/ff.c **** 			wc = ff_uni2oem(wc, CODEPAGE);			/* Unicode ==> ANSI/OEM code */
