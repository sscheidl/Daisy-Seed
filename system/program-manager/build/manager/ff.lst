 738:../../common/sd/fatfs/ff.c **** 
 739:../../common/sd/fatfs/ff.c **** /* Get a Unicode code point from the TCHAR string in defined API encodeing */
 740:../../common/sd/fatfs/ff.c **** static DWORD tchar2uni (	/* Returns a character in UTF-16 encoding (>=0x10000 on surrogate pair, 0x
 741:../../common/sd/fatfs/ff.c **** 	const TCHAR** str		/* Pointer to pointer to TCHAR string in configured encoding */
 742:../../common/sd/fatfs/ff.c **** )
 743:../../common/sd/fatfs/ff.c **** {
 744:../../common/sd/fatfs/ff.c **** 	DWORD uc;
 745:../../common/sd/fatfs/ff.c **** 	const TCHAR *p = *str;
 746:../../common/sd/fatfs/ff.c **** 
 747:../../common/sd/fatfs/ff.c **** #if FF_LFN_UNICODE == 1		/* UTF-16 input */
 748:../../common/sd/fatfs/ff.c **** 	WCHAR wc;
 749:../../common/sd/fatfs/ff.c **** 
 750:../../common/sd/fatfs/ff.c **** 	uc = *p++;	/* Get an encoding unit */
 751:../../common/sd/fatfs/ff.c **** 	if (IsSurrogate(uc)) {	/* Surrogate? */
 752:../../common/sd/fatfs/ff.c **** 		wc = *p++;		/* Get low surrogate */
 753:../../common/sd/fatfs/ff.c **** 		if (!IsSurrogateH(uc) || !IsSurrogateL(wc)) return 0xFFFFFFFF;	/* Wrong surrogate? */
 754:../../common/sd/fatfs/ff.c **** 		uc = uc << 16 | wc;
 755:../../common/sd/fatfs/ff.c **** 	}
 756:../../common/sd/fatfs/ff.c **** 
 757:../../common/sd/fatfs/ff.c **** #elif FF_LFN_UNICODE == 2	/* UTF-8 input */
 758:../../common/sd/fatfs/ff.c **** 	BYTE tb;
 759:../../common/sd/fatfs/ff.c **** 	int nf;
 760:../../common/sd/fatfs/ff.c **** 
 761:../../common/sd/fatfs/ff.c **** 	uc = (BYTE)*p++;	/* Get an encoding unit */
 762:../../common/sd/fatfs/ff.c **** 	if (uc & 0x80) {	/* Multiple byte code? */
 763:../../common/sd/fatfs/ff.c **** 		if        ((uc & 0xE0) == 0xC0) {	/* 2-byte sequence? */
 764:../../common/sd/fatfs/ff.c **** 			uc &= 0x1F; nf = 1;
 765:../../common/sd/fatfs/ff.c **** 		} else if ((uc & 0xF0) == 0xE0) {	/* 3-byte sequence? */
 766:../../common/sd/fatfs/ff.c **** 			uc &= 0x0F; nf = 2;
 767:../../common/sd/fatfs/ff.c **** 		} else if ((uc & 0xF8) == 0xF0) {	/* 4-byte sequence? */
 768:../../common/sd/fatfs/ff.c **** 			uc &= 0x07; nf = 3;
 769:../../common/sd/fatfs/ff.c **** 		} else {							/* Wrong sequence */
 770:../../common/sd/fatfs/ff.c **** 			return 0xFFFFFFFF;
 771:../../common/sd/fatfs/ff.c **** 		}
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccH1nrpr.s 			page 15


 772:../../common/sd/fatfs/ff.c **** 		do {	/* Get and merge trailing bytes */
 773:../../common/sd/fatfs/ff.c **** 			tb = (BYTE)*p++;
 774:../../common/sd/fatfs/ff.c **** 			if ((tb & 0xC0) != 0x80) return 0xFFFFFFFF;	/* Wrong sequence? */
 775:../../common/sd/fatfs/ff.c **** 			uc = uc << 6 | (tb & 0x3F);
 776:../../common/sd/fatfs/ff.c **** 		} while (--nf != 0);
 777:../../common/sd/fatfs/ff.c **** 		if (uc < 0x80 || IsSurrogate(uc) || uc >= 0x110000) return 0xFFFFFFFF;	/* Wrong code? */
 778:../../common/sd/fatfs/ff.c **** 		if (uc >= 0x010000) uc = 0xD800DC00 | ((uc - 0x10000) << 6 & 0x3FF0000) | (uc & 0x3FF);	/* Make a
 779:../../common/sd/fatfs/ff.c **** 	}
 780:../../common/sd/fatfs/ff.c **** 
 781:../../common/sd/fatfs/ff.c **** #elif FF_LFN_UNICODE == 3	/* UTF-32 input */
 782:../../common/sd/fatfs/ff.c **** 	uc = (TCHAR)*p++;	/* Get a unit */
 783:../../common/sd/fatfs/ff.c **** 	if (uc >= 0x110000 || IsSurrogate(uc)) return 0xFFFFFFFF;	/* Wrong code? */
