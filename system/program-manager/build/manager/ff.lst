1002:../../common/sd/fatfs/ff.c **** 		if (i == FF_FS_LOCK) return 0;	/* No free entry to register (int err) */
1003:../../common/sd/fatfs/ff.c **** 		Files[i].fs = dp->obj.fs;
1004:../../common/sd/fatfs/ff.c **** 		Files[i].clu = dp->obj.sclust;
1005:../../common/sd/fatfs/ff.c **** 		Files[i].ofs = dp->dptr;
