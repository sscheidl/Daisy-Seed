1798:../../common/sd/fatfs/ff.c **** 					if (clst == 1) return FR_INT_ERR;			/* Internal error */
1799:../../common/sd/fatfs/ff.c **** 					if (clst == 0xFFFFFFFF) return FR_DISK_ERR;	/* Disk error */
1800:../../common/sd/fatfs/ff.c **** 					if (dir_clear(fs, clst) != FR_OK) return FR_DISK_ERR;	/* Clean up the stretched table */
