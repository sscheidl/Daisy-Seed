2355:../../common/sd/fatfs/ff.c **** 		}
2356:../../common/sd/fatfs/ff.c **** #if FF_FS_EXFAT
2357:../../common/sd/fatfs/ff.c **** 		if (fs->fs_type == FS_EXFAT) {	/* On the exFAT volume */
2358:../../common/sd/fatfs/ff.c **** 			if (FF_USE_LABEL && vol) {
2359:../../common/sd/fatfs/ff.c **** 				if (et == ET_VLABEL) break;	/* Volume label entry? */
2360:../../common/sd/fatfs/ff.c **** 			} else {
2361:../../common/sd/fatfs/ff.c **** 				if (et == ET_FILEDIR) {		/* Start of the file entry block? */
2362:../../common/sd/fatfs/ff.c **** 					dp->blk_ofs = dp->dptr;	/* Get location of the block */
2363:../../common/sd/fatfs/ff.c **** 					res = load_xdir(dp);	/* Load the entry block */
2364:../../common/sd/fatfs/ff.c **** 					if (res == FR_OK) {
2365:../../common/sd/fatfs/ff.c **** 						dp->obj.attr = fs->dirbuf[XDIR_Attr] & AM_MASK;	/* Get attribute */
