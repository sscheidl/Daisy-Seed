2318:../../common/sd/fatfs/ff.c **** 
2319:../../common/sd/fatfs/ff.c **** 	dirb[XDIR_NumName] = nlen;		/* Set name length */
2320:../../common/sd/fatfs/ff.c **** 	dirb[XDIR_NumSec] = 1 + n_c1;	/* Set secondary count (C0 + C1s) */
2321:../../common/sd/fatfs/ff.c **** 	st_16(dirb + XDIR_NameHash, xname_sum(lfn));	/* Set name hash */
2322:../../common/sd/fatfs/ff.c **** }
