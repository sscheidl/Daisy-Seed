 829:../../common/sd/fatfs/ff.c **** 
 830:../../common/sd/fatfs/ff.c **** #elif FF_LFN_UNICODE == 2	/* UTF-8 output */
 831:../../common/sd/fatfs/ff.c **** 	DWORD hc;
 832:../../common/sd/fatfs/ff.c **** 
 833:../../common/sd/fatfs/ff.c **** 	if (chr < 0x80) {	/* Single byte code? */
 834:../../common/sd/fatfs/ff.c **** 		if (szb < 1) return 0;	/* Buffer overflow? */
 835:../../common/sd/fatfs/ff.c **** 		*buf = (TCHAR)chr;
 836:../../common/sd/fatfs/ff.c **** 		return 1;
 837:../../common/sd/fatfs/ff.c **** 	}
 838:../../common/sd/fatfs/ff.c **** 	if (chr < 0x800) {	/* 2-byte sequence? */
 839:../../common/sd/fatfs/ff.c **** 		if (szb < 2) return 0;	/* Buffer overflow? */
 840:../../common/sd/fatfs/ff.c **** 		*buf++ = (TCHAR)(0xC0 | (chr >> 6 & 0x1F));
 841:../../common/sd/fatfs/ff.c **** 		*buf++ = (TCHAR)(0x80 | (chr >> 0 & 0x3F));
 842:../../common/sd/fatfs/ff.c **** 		return 2;
 843:../../common/sd/fatfs/ff.c **** 	}
 844:../../common/sd/fatfs/ff.c **** 	if (chr < 0x10000) {	/* 3-byte sequence? */
 845:../../common/sd/fatfs/ff.c **** 		if (szb < 3 || IsSurrogate(chr)) return 0;	/* Buffer overflow or wrong code? */
 846:../../common/sd/fatfs/ff.c **** 		*buf++ = (TCHAR)(0xE0 | (chr >> 12 & 0x0F));
 847:../../common/sd/fatfs/ff.c **** 		*buf++ = (TCHAR)(0x80 | (chr >> 6 & 0x3F));
 848:../../common/sd/fatfs/ff.c **** 		*buf++ = (TCHAR)(0x80 | (chr >> 0 & 0x3F));
 849:../../common/sd/fatfs/ff.c **** 		return 3;
 850:../../common/sd/fatfs/ff.c **** 	}
 851:../../common/sd/fatfs/ff.c **** 	/* 4-byte sequence */
 852:../../common/sd/fatfs/ff.c **** 	if (szb < 4) return 0;	/* Buffer overflow? */
 853:../../common/sd/fatfs/ff.c **** 	hc = ((chr & 0xFFFF0000) - 0xD8000000) >> 6;	/* Get high 10 bits */
 854:../../common/sd/fatfs/ff.c **** 	chr = (chr & 0xFFFF) - 0xDC00;					/* Get low 10 bits */
 855:../../common/sd/fatfs/ff.c **** 	if (hc >= 0x100000 || chr >= 0x400) return 0;	/* Wrong surrogate? */
