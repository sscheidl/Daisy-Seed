2940:../../common/sd/fatfs/ff.c **** #endif
2941:../../common/sd/fatfs/ff.c **** 	while (di) {					/* Snip off trailing spaces and dots if exist */
2942:../../common/sd/fatfs/ff.c **** 		wc = lfn[di - 1];
2943:../../common/sd/fatfs/ff.c **** 		if (wc != ' ' && wc != '.') break;
