1789:../../common/sd/fatfs/ff.c **** 				if (clst <= 1) return FR_INT_ERR;			/* Internal error */
1790:../../common/sd/fatfs/ff.c **** 				if (clst == 0xFFFFFFFF) return FR_DISK_ERR;	/* Disk error */
1791:../../common/sd/fatfs/ff.c **** 				if (clst >= fs->n_fatent) {					/* It reached end of dynamic table */
1792:../../common/sd/fatfs/ff.c **** #if !FF_FS_READONLY
1793:../../common/sd/fatfs/ff.c **** 					if (!stretch) {								/* If no stretch, report EOT */
