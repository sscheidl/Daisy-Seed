2810:../../common/sd/fatfs/ff.c **** static DWORD get_achar (	/* Get a character and advance ptr */
2811:../../common/sd/fatfs/ff.c **** 	const TCHAR** ptr		/* Pointer to pointer to the ANSI/OEM or Unicode string */
2812:../../common/sd/fatfs/ff.c **** )
2813:../../common/sd/fatfs/ff.c **** {
2814:../../common/sd/fatfs/ff.c **** 	DWORD chr;
2815:../../common/sd/fatfs/ff.c **** 
2816:../../common/sd/fatfs/ff.c **** 
2817:../../common/sd/fatfs/ff.c **** #if FF_USE_LFN && FF_LFN_UNICODE >= 1	/* Unicode input */
2818:../../common/sd/fatfs/ff.c **** 	chr = tchar2uni(ptr);
2819:../../common/sd/fatfs/ff.c **** 	if (chr == 0xFFFFFFFF) chr = 0;		/* Wrong UTF encoding is recognized as end of the string */
2820:../../common/sd/fatfs/ff.c **** 	chr = ff_wtoupper(chr);
2821:../../common/sd/fatfs/ff.c **** 
2822:../../common/sd/fatfs/ff.c **** #else									/* ANSI/OEM input */
