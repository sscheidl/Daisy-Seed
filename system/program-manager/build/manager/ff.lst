2336:../../common/sd/fatfs/ff.c **** 
2337:../../common/sd/fatfs/ff.c **** static FRESULT dir_read (
2338:../../common/sd/fatfs/ff.c **** 	DIR* dp,		/* Pointer to the directory object */
2339:../../common/sd/fatfs/ff.c **** 	int vol			/* Filtered by 0:file/directory or 1:volume label */
2340:../../common/sd/fatfs/ff.c **** )
2341:../../common/sd/fatfs/ff.c **** {
2342:../../common/sd/fatfs/ff.c **** 	FRESULT res = FR_NO_FILE;
