 717:../../common/sd/fatfs/ff.c **** {
 718:../../common/sd/fatfs/ff.c **** #if FF_CODE_PAGE == 0		/* Variable code page */
 719:../../common/sd/fatfs/ff.c **** 	if (DbcTbl && c >= DbcTbl[4]) {
 720:../../common/sd/fatfs/ff.c **** 		if (c <= DbcTbl[5]) return 1;					/* 2nd byte range 1 */
 721:../../common/sd/fatfs/ff.c **** 		if (c >= DbcTbl[6] && c <= DbcTbl[7]) return 1;	/* 2nd byte range 2 */
 722:../../common/sd/fatfs/ff.c **** 		if (c >= DbcTbl[8] && c <= DbcTbl[9]) return 1;	/* 2nd byte range 3 */
 723:../../common/sd/fatfs/ff.c **** 	}
 724:../../common/sd/fatfs/ff.c **** #elif FF_CODE_PAGE >= 900	/* DBCS fixed code page */
 725:../../common/sd/fatfs/ff.c **** 	if (c >= DbcTbl[4]) {
 726:../../common/sd/fatfs/ff.c **** 		if (c <= DbcTbl[5]) return 1;
 727:../../common/sd/fatfs/ff.c **** 		if (c >= DbcTbl[6] && c <= DbcTbl[7]) return 1;
 728:../../common/sd/fatfs/ff.c **** 		if (c >= DbcTbl[8] && c <= DbcTbl[9]) return 1;
 729:../../common/sd/fatfs/ff.c **** 	}
 730:../../common/sd/fatfs/ff.c **** #else						/* SBCS fixed code page */
 731:../../common/sd/fatfs/ff.c **** 	if (c != 0) return 0;	/* Always false */
 732:../../common/sd/fatfs/ff.c **** #endif
 733:../../common/sd/fatfs/ff.c **** 	return 0;
 734:../../common/sd/fatfs/ff.c **** }
