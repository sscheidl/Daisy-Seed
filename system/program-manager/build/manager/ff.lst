 695:../../common/sd/fatfs/ff.c **** /* Test if the byte is DBC 1st byte */
 696:../../common/sd/fatfs/ff.c **** static int dbc_1st (BYTE c)
 697:../../common/sd/fatfs/ff.c **** {
 698:../../common/sd/fatfs/ff.c **** #if FF_CODE_PAGE == 0		/* Variable code page */
 699:../../common/sd/fatfs/ff.c **** 	if (DbcTbl && c >= DbcTbl[0]) {
 700:../../common/sd/fatfs/ff.c **** 		if (c <= DbcTbl[1]) return 1;					/* 1st byte range 1 */
 701:../../common/sd/fatfs/ff.c **** 		if (c >= DbcTbl[2] && c <= DbcTbl[3]) return 1;	/* 1st byte range 2 */
 702:../../common/sd/fatfs/ff.c **** 	}
 703:../../common/sd/fatfs/ff.c **** #elif FF_CODE_PAGE >= 900	/* DBCS fixed code page */
 704:../../common/sd/fatfs/ff.c **** 	if (c >= DbcTbl[0]) {
 705:../../common/sd/fatfs/ff.c **** 		if (c <= DbcTbl[1]) return 1;
 706:../../common/sd/fatfs/ff.c **** 		if (c >= DbcTbl[2] && c <= DbcTbl[3]) return 1;
 707:../../common/sd/fatfs/ff.c **** 	}
 708:../../common/sd/fatfs/ff.c **** #else						/* SBCS fixed code page */
 709:../../common/sd/fatfs/ff.c **** 	if (c != 0) return 0;	/* Always false */
 710:../../common/sd/fatfs/ff.c **** #endif
 711:../../common/sd/fatfs/ff.c **** 	return 0;
 712:../../common/sd/fatfs/ff.c **** }
 713:../../common/sd/fatfs/ff.c **** 
 714:../../common/sd/fatfs/ff.c **** 
