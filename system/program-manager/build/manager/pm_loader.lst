   1:src/pm_image.h **** // .dsy package header (format 1) and the BOOT_SRAM image profile "axi-sram-480k-v1".
   2:src/pm_image.h **** // Portable: no libDaisy, no allocation. The wire format is documented in
   3:src/pm_image.h **** // docs/PACKAGE.md; tools/dsy_pack.py writes it, this code reads it on the device.
   4:src/pm_image.h **** //
   5:src/pm_image.h **** // Layout, little-endian, 160 bytes:
   6:src/pm_image.h **** //   0   char[8]  magic           "DSYIMAGE"
   7:src/pm_image.h **** //   8   u16      header_version  1
   8:src/pm_image.h **** //   10  u16      header_size     160
   9:src/pm_image.h **** //   12  u32      flags           0 (any set bit is rejected: unknown feature)
  10:src/pm_image.h **** //   16  char[16] hardware        "seed3-desktop", NUL padded
  11:src/pm_image.h **** //   32  char[24] profile         "axi-sram-480k-v1", NUL padded
  12:src/pm_image.h **** //   56  char[32] product         product id, e.g. "toy-piano"
  13:src/pm_image.h **** //   88  char[16] version         product version, e.g. "0.4.0"
  14:src/pm_image.h **** //   104 u32      load_address    0x24000000
  15:src/pm_image.h **** //   108 u32      payload_offset  160
  16:src/pm_image.h **** //   112 u32      payload_length  8 .. 491520
  17:src/pm_image.h **** //   116 u8[32]   payload_sha256  SHA-256 over exactly payload_length payload bytes
  18:src/pm_image.h **** //   148 u32[2]   reserved        0
  19:src/pm_image.h **** //   156 u32      header_crc32    CRC-32 over bytes 0..155
  20:src/pm_image.h **** //   160 payload (one contiguous BOOT_SRAM image for 0x24000000)
  21:src/pm_image.h **** #pragma once
  22:src/pm_image.h **** #include <cstddef>
  23:src/pm_image.h **** #include <cstdint>
  24:src/pm_image.h **** 
  25:src/pm_image.h **** namespace pm {
  26:src/pm_image.h **** 
  27:src/pm_image.h **** constexpr uint32_t kHeaderSize = 160;
  28:src/pm_image.h **** constexpr uint16_t kHeaderVersion = 1;
  29:src/pm_image.h **** constexpr uint32_t kTargetBase = 0x24000000u;      // AXI SRAM image target
  30:src/pm_image.h **** constexpr uint32_t kTargetSize = 480u * 1024u;      // exclusive end 0x24078000
  31:src/pm_image.h **** constexpr uint32_t kMinPayload = 8;                 // at least the first two vectors
  32:src/pm_image.h **** constexpr uint32_t kDtcmBase = 0x20000000u;
  33:src/pm_image.h **** constexpr uint32_t kDtcmEnd = 0x20020000u;          // _estack of the official linkers
  34:src/pm_image.h **** constexpr char kMagic[8] = {'D', 'S', 'Y', 'I', 'M', 'A', 'G', 'E'};
