   1:src/pm_loader.h **** // Loads one .dsy package from the card into the SRAM target and commits the start.
   2:src/pm_loader.h **** // Portable state machine, driven from the main loop in small steps; the hardware
   3:src/pm_loader.h **** // (SD/FatFs, cache, BootInfo, reset) is reached only through the interfaces below,
ARM GAS  C:\Users\ssche\AppData\Local\Temp\cc6b1sKd.s 			page 4


   4:src/pm_loader.h **** // so the complete order of checks and the commit sequence are host-tested.
   5:src/pm_loader.h **** //
   6:src/pm_loader.h **** // Contract (docs/CONTRACT.md, section 7): nothing is committed before the whole
   7:src/pm_loader.h **** // payload has been read, hashed and checked; on any error the target may contain a
   8:src/pm_loader.h **** // partial image but BootInfo is never written. The commit order is fixed:
   9:src/pm_loader.h **** // Quiesce() -> Clean() -> Commit().
  10:src/pm_loader.h **** #pragma once
  11:src/pm_loader.h **** #include "pm_catalog.h"
  12:src/pm_loader.h **** #include "pm_image.h"
  13:src/pm_loader.h **** #include "pm_sha256.h"
  14:src/pm_loader.h **** 
  15:src/pm_loader.h **** namespace pm {
  16:src/pm_loader.h **** 
  17:src/pm_loader.h **** // Program file access (one open file at a time). Main loop only.
  18:src/pm_loader.h **** class ImageSource {
  19:src/pm_loader.h ****   public:
  20:src/pm_loader.h ****     // Opens a catalog path ("PROGRAMS/..." below /DAISY). `file_size` is the exact length.
  21:src/pm_loader.h ****     virtual bool Open(const char* path, uint32_t& file_size) = 0;
  22:src/pm_loader.h ****     // Reads up to `len` bytes; returns the count (0 at end of file), negative on error.
  23:src/pm_loader.h ****     virtual int32_t Read(uint8_t* dst, uint32_t len) = 0;
  24:src/pm_loader.h ****     virtual void Close() = 0;
  25:src/pm_loader.h ****     virtual bool CardPresent() = 0;
  26:src/pm_loader.h **** 
  27:src/pm_loader.h ****   protected:
  28:src/pm_loader.h ****     ~ImageSource() = default;
  29:src/pm_loader.h **** };
  30:src/pm_loader.h **** 
  31:src/pm_loader.h **** // The 480 KiB image target (0x24000000 on the board, a buffer on the host).
  32:src/pm_loader.h **** class LoadTarget {
  33:src/pm_loader.h ****   public:
  34:src/pm_loader.h ****     virtual uint8_t* Base() = 0;
  35:src/pm_loader.h ****     virtual uint32_t Capacity() = 0;  // kTargetSize on the board
  36:src/pm_loader.h ****     // Writes back dirty data-cache lines of [Base, Base+len) and orders the writes.
  37:src/pm_loader.h ****     // Called once, after Quiesce(), before Commit().
  38:src/pm_loader.h ****     virtual void Clean(uint32_t len) = 0;
  39:src/pm_loader.h **** 
  40:src/pm_loader.h ****   protected:
  41:src/pm_loader.h ****     ~LoadTarget() = default;
  42:src/pm_loader.h **** };
  43:src/pm_loader.h **** 
  44:src/pm_loader.h **** class BootCommit {
  45:src/pm_loader.h ****   public:
  46:src/pm_loader.h ****     // Stops everything that could still write memory or needs an orderly end:
  47:src/pm_loader.h ****     // audio, SD, LED/USB transfers. Called before Clean().
  48:src/pm_loader.h ****     virtual void Quiesce() = 0;
  49:src/pm_loader.h ****     // Writes the bootloader's JUMP order for `address` and resets. On the board this
  50:src/pm_loader.h ****     // does not return; the host fake records the call.
  51:src/pm_loader.h ****     virtual void Commit(uint32_t address) = 0;
  52:src/pm_loader.h **** 
  53:src/pm_loader.h ****   protected:
  54:src/pm_loader.h ****     ~BootCommit() = default;
  55:src/pm_loader.h **** };
