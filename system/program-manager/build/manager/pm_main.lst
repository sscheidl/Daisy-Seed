 226:src/pm_main.cpp ****     // Diagnostics SDTEST through the same driver: mount, count root entries, report.
 227:src/pm_main.cpp ****     diag::SdResult RunSdTest(bool card_present) {
 228:src/pm_main.cpp ****         diag::SdResult result;
 229:src/pm_main.cpp ****         if(!card_present)
 230:src/pm_main.cpp ****             return result;
 231:src/pm_main.cpp ****         Unmount();
 232:src/pm_main.cpp ****         int fresult;
 233:src/pm_main.cpp ****         if(!Mount(fresult)) {
 234:src/pm_main.cpp ****             result.status = diag::SdStatus::Error;
 235:src/pm_main.cpp ****             result.fresult = fresult;
 236:src/pm_main.cpp ****             return result;
 237:src/pm_main.cpp ****         }
 238:src/pm_main.cpp ****         result.fs_type = FsTypeName(sd_fs.fs_type);
 239:src/pm_main.cpp ****         const uint64_t sectors = static_cast<uint64_t>(sd_fs.n_fatent - 2) * sd_fs.csize;
 240:src/pm_main.cpp ****         result.size_mb = static_cast<uint32_t>(sectors * 512u / (1024u * 1024u));
 241:src/pm_main.cpp ****         FRESULT r = f_opendir(&sd_dir, "0:/");
 242:src/pm_main.cpp ****         if(r == FR_OK) {
 243:src/pm_main.cpp ****             while(result.entries < 1000) {
 244:src/pm_main.cpp ****                 r = f_readdir(&sd_dir, &sd_info);
 245:src/pm_main.cpp ****                 if(r != FR_OK || sd_info.fname[0] == 0)
 246:src/pm_main.cpp ****                     break;
 247:src/pm_main.cpp ****                 ++result.entries;
 248:src/pm_main.cpp ****             }
 249:src/pm_main.cpp ****             f_closedir(&sd_dir);
 250:src/pm_main.cpp ****         }
 251:src/pm_main.cpp ****         result.status = r == FR_OK ? diag::SdStatus::Mounted : diag::SdStatus::Error;
 252:src/pm_main.cpp ****         result.fresult = r;
 253:src/pm_main.cpp ****         return result;
 254:src/pm_main.cpp ****     }
