 266:src/pm_main.cpp ****     }
 267:src/pm_main.cpp ****     static const char* FsTypeName(BYTE type) {
 268:src/pm_main.cpp ****         switch(type) {
 269:src/pm_main.cpp ****             case FS_FAT12: return "FAT12";
 270:src/pm_main.cpp ****             case FS_FAT16: return "FAT16";
