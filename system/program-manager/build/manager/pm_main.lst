  37:src/pm_manager.h **** const char* CatalogStateName(CatalogState state);
  38:src/pm_manager.h **** 
  39:src/pm_manager.h **** // What the panel LEDs should show. `owner_diag` means the diagnostics layer drives them.
  40:src/pm_manager.h **** struct LedFrame {
  41:src/pm_manager.h ****     uint16_t dim = 0;     // bit i = LED i+1 at low brightness
  42:src/pm_manager.h ****     uint16_t bright = 0;  // bit i = LED i+1 at full brightness
  43:src/pm_manager.h ****     bool owner_diag = false;
  44:src/pm_manager.h **** };
  45:src/pm_manager.h **** 
  46:src/pm_manager.h **** enum class StartResult : uint8_t {
  47:src/pm_manager.h ****     Accepted = 0,
  48:src/pm_manager.h ****     Duplicate,      // same request id as the last accepted request: not started again
  49:src/pm_manager.h ****     WrongMode,      // only in Select
  50:src/pm_manager.h ****     Busy,           // a load is active
  51:src/pm_manager.h ****     NoCatalog,      // no valid catalog (no card, missing, invalid)
  52:src/pm_manager.h ****     Generation,     // catalog generation does not match the current one
  53:src/pm_manager.h ****     NoEntry,        // slot empty or id differs from the slot's entry
  54:src/pm_manager.h ****     Hash,           // expected hash (prefix) differs from the catalog entry
  55:src/pm_manager.h ****     Unsupported,    // probe profile: no SD start
  56:src/pm_manager.h **** };
  57:src/pm_manager.h **** const char* StartResultName(StartResult result);
