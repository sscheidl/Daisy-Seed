   1:../../diagnostics/firmware/src/devkit_board.h **** // Seed3 Desktop hardware adapter shared by the diagnostic firmware and the program
   2:../../diagnostics/firmware/src/devkit_board.h **** // manager: control sampling in the audio callback, test tone / peak meters / snapshot
   3:../../diagnostics/firmware/src/devkit_board.h **** // capture, the USB CDC sink and the diag::Board methods that only need the kit itself.
   4:../../diagnostics/firmware/src/devkit_board.h **** // Card access and the bootloader entry stay with each firmware (SD driver and modes
   5:../../diagnostics/firmware/src/devkit_board.h **** // differ), so firmwares derive from DevkitBoardBase and implement those.
   6:../../diagnostics/firmware/src/devkit_board.h **** //
