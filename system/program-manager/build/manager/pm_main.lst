  18:../../diagnostics/firmware/src/devkit_board.h **** 
  19:../../diagnostics/firmware/src/devkit_board.h **** // libDaisy configures USB and audio DMA with priority 0; the USB interrupt is moved
  20:../../diagnostics/firmware/src/devkit_board.h **** // to 1 so audio preempts it (see SetUsbPriority()).
  21:../../diagnostics/firmware/src/devkit_board.h **** constexpr uint32_t kUsbIrqPriority = 1;
  22:../../diagnostics/firmware/src/devkit_board.h **** 
  23:../../diagnostics/firmware/src/devkit_board.h **** inline Sw18 MapSwitch3(int pos) {
  24:../../diagnostics/firmware/src/devkit_board.h ****     switch(pos) {
  25:../../diagnostics/firmware/src/devkit_board.h ****         case daisy::Switch3::POS_UP: return Sw18::Up;
  26:../../diagnostics/firmware/src/devkit_board.h ****         case daisy::Switch3::POS_DOWN: return Sw18::Down;
  27:../../diagnostics/firmware/src/devkit_board.h ****         default: return Sw18::Center;
  28:../../diagnostics/firmware/src/devkit_board.h ****     }
  29:../../diagnostics/firmware/src/devkit_board.h **** }
  30:../../diagnostics/firmware/src/devkit_board.h **** 
  31:../../diagnostics/firmware/src/devkit_board.h **** inline const char* BootloaderName(daisy::System::BootInfo::Version version) {
  32:../../diagnostics/firmware/src/devkit_board.h ****     switch(version) {
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccJoEdPM.s 			page 6


  33:../../diagnostics/firmware/src/devkit_board.h ****         case daisy::System::BootInfo::Version::LT_v6_0: return "LT_v6_0";
  34:../../diagnostics/firmware/src/devkit_board.h ****         case daisy::System::BootInfo::Version::NONE: return "NONE";
  35:../../diagnostics/firmware/src/devkit_board.h ****         case daisy::System::BootInfo::Version::v6_0: return "v6_0";
  36:../../diagnostics/firmware/src/devkit_board.h ****         case daisy::System::BootInfo::Version::v6_1: return "v6_1";
