 235:../../diagnostics/firmware/src/devkit_board.h **** // ---- USB CDC transmit -------------------------------------------------------------
 236:../../diagnostics/firmware/src/devkit_board.h **** // libDaisy's CDC_Transmit_HS() dereferences the class data without a NULL check, and
 237:../../diagnostics/firmware/src/devkit_board.h **** // a USB reset handled in the OTG_HS interrupt frees that data (pClassData = NULL).
 238:../../diagnostics/firmware/src/devkit_board.h **** // The readiness check and the start of the transfer therefore run with the USB
 239:../../diagnostics/firmware/src/devkit_board.h **** // interrupt (priority 1) masked via BASEPRI; the audio interrupt (priority 0) still runs.
 240:../../diagnostics/firmware/src/devkit_board.h **** class CdcSink final : public UsbSink {
 241:../../diagnostics/firmware/src/devkit_board.h ****   public:
 242:../../diagnostics/firmware/src/devkit_board.h ****     explicit CdcSink(daisy::UsbHandle& usb) : usb_(usb) {}
 243:../../diagnostics/firmware/src/devkit_board.h ****     SendResult Send(const uint8_t* data, size_t len) override {
 244:../../diagnostics/firmware/src/devkit_board.h ****         const uint32_t saved = __get_BASEPRI();
 245:../../diagnostics/firmware/src/devkit_board.h ****         __set_BASEPRI(kUsbIrqPriority << (8u - __NVIC_PRIO_BITS));
 246:../../diagnostics/firmware/src/devkit_board.h ****         __DSB();
 247:../../diagnostics/firmware/src/devkit_board.h ****         __ISB();
 248:../../diagnostics/firmware/src/devkit_board.h ****         SendResult result;
 249:../../diagnostics/firmware/src/devkit_board.h ****         if(hUsbDeviceHS.dev_state != USBD_STATE_CONFIGURED || hUsbDeviceHS.pClassData == nullptr)
 250:../../diagnostics/firmware/src/devkit_board.h ****             result = SendResult::NotReady;
 251:../../diagnostics/firmware/src/devkit_board.h ****         else if(usb_.TransmitExternal(const_cast<uint8_t*>(data), len) == daisy::UsbHandle::Result:
 252:../../diagnostics/firmware/src/devkit_board.h ****             result = SendResult::Ok;
 253:../../diagnostics/firmware/src/devkit_board.h ****         else
 254:../../diagnostics/firmware/src/devkit_board.h ****             result = SendResult::Busy;
 255:../../diagnostics/firmware/src/devkit_board.h ****         __set_BASEPRI(saved);
 256:../../diagnostics/firmware/src/devkit_board.h ****         return result;
 257:../../diagnostics/firmware/src/devkit_board.h ****     }
 258:../../diagnostics/firmware/src/devkit_board.h **** 
 259:../../diagnostics/firmware/src/devkit_board.h ****   private:
 260:../../diagnostics/firmware/src/devkit_board.h ****     daisy::UsbHandle& usb_;
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccxMmWCu.s 			page 10


 261:../../diagnostics/firmware/src/devkit_board.h **** };
