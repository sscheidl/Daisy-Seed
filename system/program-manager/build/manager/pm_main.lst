 256:src/pm_main.cpp ****   private:
 257:src/pm_main.cpp ****     static bool NameHasBin(const char* name) {
 258:src/pm_main.cpp ****         // ".bin" in any case anywhere in the name, as the bootloader's strstr(".bin"/".BIN")
 259:src/pm_main.cpp ****         // plus mixed case; conservative by design.
 260:src/pm_main.cpp ****         char lower[FF_MAX_LFN + 1];
 261:src/pm_main.cpp ****         size_t n = 0;
 262:src/pm_main.cpp ****         for(; name[n] && n < FF_MAX_LFN; ++n)
 263:src/pm_main.cpp ****             lower[n] = static_cast<char>(name[n] >= 'A' && name[n] <= 'Z' ? name[n] + 32 : name[n])
