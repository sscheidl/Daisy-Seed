  95:src/pm_main.cpp **** // The bounce buffer is the only SDMMC1 IDMA target: AXI SRAM above the image target
  96:src/pm_main.cpp **** // (linker section .pm_axi_bounce), 32-byte aligned, whole cache lines. FatFs objects
  97:src/pm_main.cpp **** // and the catalog text live in DTCM like any other .bss (CPU copies only).
  98:src/pm_main.cpp **** constexpr uint32_t kBounceBytes = 4096;  // 8 sectors per transfer
  99:src/pm_main.cpp **** __attribute__((section(".pm_axi_bounce"), aligned(32))) uint8_t sd_bounce[kBounceBytes];
