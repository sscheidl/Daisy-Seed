   1:src/pm_manager.h **** // Program manager core: operating modes, key selection, LED display, catalog scan
   2:src/pm_manager.h **** // and the hand-over to the loader. Portable (host-tested); main.cpp supplies the
   3:src/pm_manager.h **** // storage, target and boot commit, and feeds keys/card state once per main-loop step.
   4:src/pm_manager.h **** //
   5:src/pm_manager.h **** // Modes (docs/CONTRACT.md, section 8):
   6:src/pm_manager.h **** //   Select      keys 1..15 choose a catalog slot, key 16 opens the resident diagnostics
   7:src/pm_manager.h **** //   Diagnostics the diagnostics layer owns keys/LEDs; S1+S16 held 3 s returns to Select
   8:src/pm_manager.h **** //   Loading     a package is being checked and copied; keys are ignored
   9:src/pm_manager.h **** //   Service     a bootloader (DFU) entry was requested; the caller performs the reset
  10:src/pm_manager.h **** #pragma once
  11:src/pm_manager.h **** #include "pm_catalog.h"
  12:src/pm_manager.h **** #include "pm_loader.h"
  13:src/pm_manager.h **** 
  14:src/pm_manager.h **** namespace pm {
  15:src/pm_manager.h **** 
  16:src/pm_manager.h **** // Card access beyond single program files: catalog and root listing. Main loop only.
  17:src/pm_manager.h **** class Storage : public ImageSource {
  18:src/pm_manager.h ****   public:
  19:src/pm_manager.h ****     enum class CatalogResult : uint8_t { Ok, NoCard, MountFailed, Missing, TooLarge, ReadError };
  20:src/pm_manager.h ****     // Mounts the card if necessary and reads /DAISY/catalog.json into buf[cap].
  21:src/pm_manager.h ****     // `len` receives the byte count; `detail` an implementation code (FRESULT).
  22:src/pm_manager.h ****     virtual CatalogResult ReadCatalog(char* buf, uint32_t cap, uint32_t& len, int& detail) = 0;
  23:src/pm_manager.h ****     // True when a root directory entry contains ".bin" in any case (the stock
  24:src/pm_manager.h ****     // bootloader would flash it before this manager even starts; README/Kartenregel).
  25:src/pm_manager.h ****     virtual bool RootHasBinFile() = 0;
  26:src/pm_manager.h ****     // Releases the card (after removal or before a rescan).
  27:src/pm_manager.h ****     virtual void Unmount() = 0;
  28:src/pm_manager.h **** 
  29:src/pm_manager.h ****   protected:
  30:src/pm_manager.h ****     ~Storage() = default;
  31:src/pm_manager.h **** };
  32:src/pm_manager.h **** 
  33:src/pm_manager.h **** enum class Mode : uint8_t { Select, Diagnostics, Loading, Service };
  34:src/pm_manager.h **** const char* ModeName(Mode mode);
  35:src/pm_manager.h **** 
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccxMmWCu.s 			page 121


  36:src/pm_manager.h **** enum class CatalogState : uint8_t { NoCard, Scanning, Ok, Missing, Invalid, MountFailed, ReadError,
  37:src/pm_manager.h **** const char* CatalogStateName(CatalogState state);
  38:src/pm_manager.h **** 
  39:src/pm_manager.h **** // What the panel LEDs should show. `owner_diag` means the diagnostics layer drives them.
  40:src/pm_manager.h **** struct LedFrame {
  41:src/pm_manager.h ****     uint16_t dim = 0;     // bit i = LED i+1 at low brightness
  42:src/pm_manager.h ****     uint16_t bright = 0;  // bit i = LED i+1 at full brightness
  43:src/pm_manager.h ****     bool owner_diag = false;
  44:src/pm_manager.h **** };
  45:src/pm_manager.h **** 
  46:src/pm_manager.h **** enum class StartResult : uint8_t {
  47:src/pm_manager.h ****     Accepted = 0,
  48:src/pm_manager.h ****     Duplicate,      // same request id as the last accepted request: not started again
  49:src/pm_manager.h ****     WrongMode,      // only in Select
  50:src/pm_manager.h ****     Busy,           // a load is active
  51:src/pm_manager.h ****     NoCatalog,      // no valid catalog (no card, missing, invalid)
  52:src/pm_manager.h ****     Generation,     // catalog generation does not match the current one
  53:src/pm_manager.h ****     NoEntry,        // slot empty or id differs from the slot's entry
  54:src/pm_manager.h ****     Hash,           // expected hash (prefix) differs from the catalog entry
  55:src/pm_manager.h ****     Unsupported,    // probe profile: no SD start
  56:src/pm_manager.h **** };
  57:src/pm_manager.h **** const char* StartResultName(StartResult result);
