  47:../../diagnostics/firmware/src/devkit_board.h **** // ---- Audio callback side: controls at 1 kHz, tone, meters, snapshot --------------
  48:../../diagnostics/firmware/src/devkit_board.h **** // The main loop writes the tone settings; the callback reads them once per block.
  49:../../diagnostics/firmware/src/devkit_board.h **** // `tone_until_ms` is refreshed by the main loop while a host session is active: a
  50:../../diagnostics/firmware/src/devkit_board.h **** // blocked or dead main loop (or a vanished host) therefore mutes the tone by itself.
  51:../../diagnostics/firmware/src/devkit_board.h **** class AudioDiagnostics {
  52:../../diagnostics/firmware/src/devkit_board.h ****   public:
  53:../../diagnostics/firmware/src/devkit_board.h ****     // Call once per audio block (48 samples at 48 kHz = 1 kHz control rate).
  54:../../diagnostics/firmware/src/devkit_board.h ****     void Process(daisy::desktop_devkit::Hardware& hw, daisy::AudioHandle::InputBuffer in,
  55:../../diagnostics/firmware/src/devkit_board.h ****                  daisy::AudioHandle::OutputBuffer out, size_t size, uint32_t now_ms) {
  56:../../diagnostics/firmware/src/devkit_board.h ****         hw.UpdateAllControls();
  57:../../diagnostics/firmware/src/devkit_board.h ****         for(size_t i = 0; i < kNumButtons; ++i)
  58:../../diagnostics/firmware/src/devkit_board.h ****             buttons_.Update(i, hw.button[i].RisingEdge(), hw.button[i].FallingEdge());
  59:../../diagnostics/firmware/src/devkit_board.h ****         sw18_.Update(MapSwitch3(hw.tog_sw18.Read()));
  60:../../diagnostics/firmware/src/devkit_board.h **** 
  61:../../diagnostics/firmware/src/devkit_board.h ****         callback_inputs_.buttons = buttons_.Held();
