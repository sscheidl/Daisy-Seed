  47:../../common/bootloader/bootloader_entry.h **** // For firmware that parses the raw USB-MIDI byte stream itself (Nebulae).
  48:../../common/bootloader/bootloader_entry.h **** // Feed every received byte; returns true when a complete request has arrived.
  49:../../common/bootloader/bootloader_entry.h **** // Real-time bytes (F8..FF) may appear inside SysEx and are skipped. No allocation,
  50:../../common/bootloader/bootloader_entry.h **** // safe in an interrupt.
  51:../../common/bootloader/bootloader_entry.h **** class SysExMatcher {
  52:../../common/bootloader/bootloader_entry.h ****   public:
  53:../../common/bootloader/bootloader_entry.h ****     bool Byte(uint8_t byte) {
  54:../../common/bootloader/bootloader_entry.h ****         if(byte >= 0xF8)
  55:../../common/bootloader/bootloader_entry.h ****             return false;
  56:../../common/bootloader/bootloader_entry.h ****         if(byte == 0xF0) {
  57:../../common/bootloader/bootloader_entry.h ****             position_ = 0;
  58:../../common/bootloader/bootloader_entry.h ****             active_ = true;
  59:../../common/bootloader/bootloader_entry.h ****             return false;
  60:../../common/bootloader/bootloader_entry.h ****         }
  61:../../common/bootloader/bootloader_entry.h ****         if(!active_)
  62:../../common/bootloader/bootloader_entry.h ****             return false;
  63:../../common/bootloader/bootloader_entry.h ****         if(byte == 0xF7) {
  64:../../common/bootloader/bootloader_entry.h ****             active_ = false;
  65:../../common/bootloader/bootloader_entry.h ****             return position_ == sizeof(kRequestBody);
  66:../../common/bootloader/bootloader_entry.h ****         }
  67:../../common/bootloader/bootloader_entry.h ****         if(byte & 0x80 || position_ >= sizeof(kRequestBody) || byte != kRequestBody[position_]) {
  68:../../common/bootloader/bootloader_entry.h ****             active_ = false; // another status byte, a longer or a different message
  69:../../common/bootloader/bootloader_entry.h ****             return false;
  70:../../common/bootloader/bootloader_entry.h ****         }
  71:../../common/bootloader/bootloader_entry.h ****         ++position_;
  72:../../common/bootloader/bootloader_entry.h ****         return false;
  73:../../common/bootloader/bootloader_entry.h ****     }
  74:../../common/bootloader/bootloader_entry.h **** 
  75:../../common/bootloader/bootloader_entry.h ****   private:
  76:../../common/bootloader/bootloader_entry.h ****     std::size_t position_ = 0;
  77:../../common/bootloader/bootloader_entry.h ****     bool active_ = false;
  78:../../common/bootloader/bootloader_entry.h **** };
