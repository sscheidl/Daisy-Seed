  61:../../diagnostics/firmware/src/diag_app.h **** // A hosting firmware (the program manager) sees every valid frame before the Session:
  62:../../diagnostics/firmware/src/diag_app.h **** // it can add its own commands and refuse diagnostic ones in its other operating modes.
  63:../../diagnostics/firmware/src/diag_app.h **** // Returning true consumes the frame: `reply` (possibly empty) is sent and `requests`
  64:../../diagnostics/firmware/src/diag_app.h **** // is merged into the step's request mask. `session_active` is the host session state
  65:../../diagnostics/firmware/src/diag_app.h **** // before this frame. The hook must not block.
  66:../../diagnostics/firmware/src/diag_app.h **** class CommandHook {
  67:../../diagnostics/firmware/src/diag_app.h ****   public:
  68:../../diagnostics/firmware/src/diag_app.h ****     virtual bool Handle(const char* body, const char* type, bool session_active, uint32_t now_ms,
  69:../../diagnostics/firmware/src/diag_app.h ****                         ddp::Writer& reply, uint32_t& requests) = 0;
  70:../../diagnostics/firmware/src/diag_app.h **** 
  71:../../diagnostics/firmware/src/diag_app.h ****   protected:
  72:../../diagnostics/firmware/src/diag_app.h ****     ~CommandHook() = default;
  73:../../diagnostics/firmware/src/diag_app.h **** };
