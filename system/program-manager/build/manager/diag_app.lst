   4:../../common/bootloader/bootloader_entry.h **** // (bootloader_daisy.h). This header has no libDaisy dependency and is host-tested.
   5:../../common/bootloader/bootloader_entry.h **** //
   6:../../common/bootloader/bootloader_entry.h **** //   * Keys: S9 and S16, and no other key, held together for 5 s.
   7:../../common/bootloader/bootloader_entry.h **** //   * USB-MIDI SysEx: F0 7D 42 4C 01 01 42 4F 4F 54 F7 ("BL", ENTER, "BOOT").
   8:../../common/bootloader/bootloader_entry.h **** //     The firmware answers F0 7D 42 4C 01 41 F7 before it resets.
   9:../../common/bootloader/bootloader_entry.h **** //
  10:../../common/bootloader/bootloader_entry.h **** // The format is documented in common/bootloader/README.md.
  11:../../common/bootloader/bootloader_entry.h **** #include <atomic>
  12:../../common/bootloader/bootloader_entry.h **** #include <cstddef>
  13:../../common/bootloader/bootloader_entry.h **** #include <cstdint>
  14:../../common/bootloader/bootloader_entry.h **** 
  15:../../common/bootloader/bootloader_entry.h **** // Component version for the manifest (components/registry.json), three-part SemVer.
  16:../../common/bootloader/bootloader_entry.h **** // The SysEx frame keeps its own version byte (kVersion).
  17:../../common/bootloader/bootloader_entry.h **** #define BOOTLOADER_ENTRY_VERSION "1.0.0"
  18:../../common/bootloader/bootloader_entry.h **** 
  19:../../common/bootloader/bootloader_entry.h **** namespace bootloader {
  20:../../common/bootloader/bootloader_entry.h **** 
  21:../../common/bootloader/bootloader_entry.h **** // S9 and S16 (bit 0 = S1): the outer keys of the second row, easy to find with the
  22:../../common/bootloader/bootloader_entry.h **** // case closed. Their own press actions still run (a loop mode, sustain, C5/C6); the
  23:../../common/bootloader/bootloader_entry.h **** // reset follows only after 5 s of holding exactly this pair (README.md).
  24:../../common/bootloader/bootloader_entry.h **** constexpr uint32_t kKeyMask = (1u << 8) | (1u << 15);
  25:../../common/bootloader/bootloader_entry.h **** constexpr uint32_t kHoldMs = 5000;
  26:../../common/bootloader/bootloader_entry.h **** 
  27:../../common/bootloader/bootloader_entry.h **** // 0x7D: non-commercial manufacturer ID, shared with Mod on Daisy ("MD", 4D 44).
  28:../../common/bootloader/bootloader_entry.h **** // "BL" (42 4C) keeps the two protocols apart.
  29:../../common/bootloader/bootloader_entry.h **** constexpr uint8_t kVersion = 0x01;
  30:../../common/bootloader/bootloader_entry.h **** constexpr uint8_t kCommandEnter = 0x01;
  31:../../common/bootloader/bootloader_entry.h **** constexpr uint8_t kReplyBit = 0x40;
  32:../../common/bootloader/bootloader_entry.h **** // Bytes between F0 and F7, as libDaisy reports them in MidiEvent::sysex_data.
  33:../../common/bootloader/bootloader_entry.h **** constexpr uint8_t kRequestBody[] = {0x7D, 0x42, 0x4C, kVersion, kCommandEnter, 'B', 'O', 'O', 'T'};
  34:../../common/bootloader/bootloader_entry.h **** constexpr uint8_t kRequest[] = {0xF0, 0x7D, 0x42, 0x4C, kVersion, kCommandEnter, 'B', 'O', 'O', 'T'
  35:../../common/bootloader/bootloader_entry.h **** constexpr uint8_t kAck[] = {0xF0, 0x7D, 0x42, 0x4C, kVersion, kCommandEnter | kReplyBit, 0xF7};
  36:../../common/bootloader/bootloader_entry.h **** 
  37:../../common/bootloader/bootloader_entry.h **** // True for exactly the request body; any other SysEx belongs to someone else.
  38:../../common/bootloader/bootloader_entry.h **** inline bool IsRequestBody(const uint8_t* body, std::size_t size) {
  39:../../common/bootloader/bootloader_entry.h ****     if(size != sizeof(kRequestBody))
  40:../../common/bootloader/bootloader_entry.h ****         return false;
  41:../../common/bootloader/bootloader_entry.h ****     for(std::size_t i = 0; i < size; ++i)
  42:../../common/bootloader/bootloader_entry.h ****         if(body[i] != kRequestBody[i])
  43:../../common/bootloader/bootloader_entry.h ****             return false;
  44:../../common/bootloader/bootloader_entry.h ****     return true;
  45:../../common/bootloader/bootloader_entry.h **** }
  46:../../common/bootloader/bootloader_entry.h **** 
