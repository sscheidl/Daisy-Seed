   1:../../diagnostics/protocol/ddp.h **** // Daisy Diagnostic Protocol (DDP) v1 - framing and field helpers.
   2:../../diagnostics/protocol/ddp.h **** // Portable C++17 without libDaisy, heap or exceptions; shared by firmware and host tests.
   3:../../diagnostics/protocol/ddp.h **** // Specification: PROTOCOL.md
   4:../../diagnostics/protocol/ddp.h **** #pragma once
   5:../../diagnostics/protocol/ddp.h **** #include <cstddef>
   6:../../diagnostics/protocol/ddp.h **** #include <cstdint>
   7:../../diagnostics/protocol/ddp.h **** 
   8:../../diagnostics/protocol/ddp.h **** namespace ddp {
   9:../../diagnostics/protocol/ddp.h **** 
  10:../../diagnostics/protocol/ddp.h **** constexpr int kProtocolVersion = 1;
  11:../../diagnostics/protocol/ddp.h **** constexpr size_t kMaxBody = 400;
  12:../../diagnostics/protocol/ddp.h **** // '$' + body + '*' + 4 CRC digits + '\n'
  13:../../diagnostics/protocol/ddp.h **** constexpr size_t kMaxFrame = kMaxBody + 7;
  14:../../diagnostics/protocol/ddp.h **** 
  15:../../diagnostics/protocol/ddp.h **** // CRC-16/CCITT-FALSE: poly 0x1021, init 0xFFFF, no reflection, no final XOR.
  16:../../diagnostics/protocol/ddp.h **** uint16_t Crc16(const char* data, size_t len);
  17:../../diagnostics/protocol/ddp.h **** 
  18:../../diagnostics/protocol/ddp.h **** // True for bytes allowed inside a body.
  19:../../diagnostics/protocol/ddp.h **** inline bool IsBodyChar(char c) {
  20:../../diagnostics/protocol/ddp.h ****     return c >= 0x20 && c <= 0x7e && c != '$' && c != '*';
  21:../../diagnostics/protocol/ddp.h **** }
  22:../../diagnostics/protocol/ddp.h **** 
  23:../../diagnostics/protocol/ddp.h **** // Writes "$<body>*XXXX\n" into out. Returns the frame length, or 0 if the body is
  24:../../diagnostics/protocol/ddp.h **** // invalid or does not fit (out is then left unterminated).
  25:../../diagnostics/protocol/ddp.h **** size_t BuildFrame(const char* body, size_t body_len, char* out, size_t cap);
  26:../../diagnostics/protocol/ddp.h **** 
  27:../../diagnostics/protocol/ddp.h **** // Byte-wise frame receiver with resynchronisation, see PROTOCOL.md.
  28:../../diagnostics/protocol/ddp.h **** class FrameParser {
  29:../../diagnostics/protocol/ddp.h ****   public:
  30:../../diagnostics/protocol/ddp.h ****     // Returns true when a complete, valid frame is available via Body().
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccqq4TCV.s 			page 51


  31:../../diagnostics/protocol/ddp.h ****     // The body stays valid until the next call to Feed().
  32:../../diagnostics/protocol/ddp.h ****     bool Feed(char c);
  33:../../diagnostics/protocol/ddp.h ****     const char* Body() const { return body_; }
  34:../../diagnostics/protocol/ddp.h ****     size_t BodyLength() const { return body_len_; }
  35:../../diagnostics/protocol/ddp.h ****     void Reset() { state_ = State::Idle; body_len_ = 0; }
  36:../../diagnostics/protocol/ddp.h **** 
  37:../../diagnostics/protocol/ddp.h ****     uint32_t ok = 0;
  38:../../diagnostics/protocol/ddp.h ****     uint32_t bad_crc = 0;
  39:../../diagnostics/protocol/ddp.h ****     uint32_t bad_format = 0;  // invalid character, missing '*', bad hex digits
  40:../../diagnostics/protocol/ddp.h ****     uint32_t overflow = 0;
  41:../../diagnostics/protocol/ddp.h **** 
  42:../../diagnostics/protocol/ddp.h ****   private:
  43:../../diagnostics/protocol/ddp.h ****     enum class State : uint8_t { Idle, Body, Crc, Cr };
  44:../../diagnostics/protocol/ddp.h ****     State state_ = State::Idle;
  45:../../diagnostics/protocol/ddp.h ****     char body_[kMaxBody + 1] = {};
  46:../../diagnostics/protocol/ddp.h ****     size_t body_len_ = 0;
  47:../../diagnostics/protocol/ddp.h ****     char crc_[4] = {};
  48:../../diagnostics/protocol/ddp.h ****     size_t crc_len_ = 0;
