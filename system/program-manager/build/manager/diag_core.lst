  61:../../diagnostics/protocol/ddp.h ****     size_t Length() const { return len_; }
  62:../../diagnostics/protocol/ddp.h ****     bool Ok() const { return ok_; }
  63:../../diagnostics/protocol/ddp.h **** 
  64:../../diagnostics/protocol/ddp.h ****   private:
  65:../../diagnostics/protocol/ddp.h ****     char* buf_;
  66:../../diagnostics/protocol/ddp.h ****     size_t cap_;
  67:../../diagnostics/protocol/ddp.h ****     size_t len_ = 0;
