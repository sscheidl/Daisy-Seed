  49:../../diagnostics/firmware/src/diag_app.h ****     virtual void ApplyTone(const ToneSettings&, uint32_t /*keep_until_ms*/) {}
  50:../../diagnostics/firmware/src/diag_app.h ****     // Peak levels since the previous call (the call resets them).
