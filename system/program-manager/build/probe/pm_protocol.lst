   7:src/pm_manager.h **** //   Diagnostics the diagnostics layer owns keys/LEDs; S1+S16 held 3 s returns to Select
   8:src/pm_manager.h **** //   Loading     a package is being checked and copied; keys are ignored
   9:src/pm_manager.h **** //   Service     a bootloader (DFU) entry was requested; the caller performs the reset
