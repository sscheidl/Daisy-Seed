  33:../../diagnostics/firmware/src/diag_app.h ****     // CV OUT 1/2 DAC codes 0..kDacMax; main loop only.
  34:../../diagnostics/firmware/src/diag_app.h ****     virtual void ApplyCvOut(uint16_t, uint16_t) {}
  35:../../diagnostics/firmware/src/diag_app.h ****     virtual SdResult RunSdTest(bool card_present) = 0;  // blocking, bounded
  36:../../diagnostics/firmware/src/diag_app.h ****     virtual bool SdTestAllowed() { return true; }
  37:../../diagnostics/firmware/src/diag_app.h ****     // Default board is the protected diagnostic build. Reader builds return
  38:../../diagnostics/firmware/src/diag_app.h ****     // explicit status/error bodies and never release a card on BYE or timeout.
