  14:../../diagnostics/firmware/src/diag_app.h ****     Busy,      // previous IN transfer still running, try again later
  15:../../diagnostics/firmware/src/diag_app.h ****     NotReady,  // device not configured by a host (no enumeration / USB reset)
  16:../../diagnostics/firmware/src/diag_app.h **** };
