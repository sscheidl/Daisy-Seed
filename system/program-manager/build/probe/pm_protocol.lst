   1:../../diagnostics/protocol/ddp.h **** // Daisy Diagnostic Protocol (DDP) v1 - framing and field helpers.
   2:../../diagnostics/protocol/ddp.h **** // Portable C++17 without libDaisy, heap or exceptions; shared by firmware and host tests.
   3:../../diagnostics/protocol/ddp.h **** // Specification: PROTOCOL.md
   4:../../diagnostics/protocol/ddp.h **** #pragma once
   5:../../diagnostics/protocol/ddp.h **** #include <cstddef>
