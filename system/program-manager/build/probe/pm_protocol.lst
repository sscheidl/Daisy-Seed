  16:src/pm_manager.h **** // Card access beyond single program files: catalog and root listing. Main loop only.
  17:src/pm_manager.h **** class Storage : public ImageSource {
  18:src/pm_manager.h ****   public:
  19:src/pm_manager.h ****     enum class CatalogResult : uint8_t { Ok, NoCard, MountFailed, Missing, TooLarge, ReadError };
  20:src/pm_manager.h ****     // Mounts the card if necessary and reads /DAISY/catalog.json into buf[cap].
  21:src/pm_manager.h ****     // `len` receives the byte count; `detail` an implementation code (FRESULT).
  22:src/pm_manager.h ****     virtual CatalogResult ReadCatalog(char* buf, uint32_t cap, uint32_t& len, int& detail) = 0;
  23:src/pm_manager.h ****     // True when a root directory entry contains ".bin" in any case (the stock
  24:src/pm_manager.h ****     // bootloader would flash it before this manager even starts; README/Kartenregel).
  25:src/pm_manager.h ****     virtual bool RootHasBinFile() = 0;
  26:src/pm_manager.h ****     // Releases the card (after removal or before a rescan).
  27:src/pm_manager.h ****     virtual void Unmount() = 0;
  28:src/pm_manager.h **** 
  29:src/pm_manager.h ****   protected:
  30:src/pm_manager.h ****     ~Storage() = default;
  31:src/pm_manager.h **** };
