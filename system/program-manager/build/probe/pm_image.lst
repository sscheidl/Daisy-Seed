  19:src/pm_image.cpp **** // A fixed field holds a non-empty string, NUL terminated inside the field, with only
  20:src/pm_image.cpp **** // zero bytes after the terminator and only characters accepted by `ok`.
  21:src/pm_image.cpp **** bool CopyField(const uint8_t* field, size_t size, char* out, bool (*ok)(char)) {
  22:src/pm_image.cpp ****     size_t n = 0;
  23:src/pm_image.cpp ****     while(n < size && field[n] != 0) {
  24:src/pm_image.cpp ****         if(!ok(static_cast<char>(field[n])))
  25:src/pm_image.cpp ****             return false;
  26:src/pm_image.cpp ****         out[n] = static_cast<char>(field[n]);
  27:src/pm_image.cpp ****         ++n;
  28:src/pm_image.cpp ****     }
  29:src/pm_image.cpp ****     if(n == 0 || n == size)  // empty, or no terminator inside the field
  30:src/pm_image.cpp ****         return false;
