 196:../../diagnostics/firmware/src/diag_core.h ****     bool HostActive(uint32_t now_ms);
 197:../../diagnostics/firmware/src/diag_core.h ****     // Counts as host activity: used after a blocking operation the host requested
 198:../../diagnostics/firmware/src/diag_core.h ****     // (SD test), during which the host's keep-alive frames could not be processed.
 199:../../diagnostics/firmware/src/diag_core.h ****     void KeepAlive(uint32_t now_ms) {
 200:../../diagnostics/firmware/src/diag_core.h ****         if(streaming_)
 201:../../diagnostics/firmware/src/diag_core.h ****             last_rx_ms_ = now_ms;
 202:../../diagnostics/firmware/src/diag_core.h ****     }
 203:../../diagnostics/firmware/src/diag_core.h ****     void WriteHello(ddp::Writer& out) const;
 204:../../diagnostics/firmware/src/diag_core.h **** 
 205:../../diagnostics/firmware/src/diag_core.h ****     Settings settings;
 206:../../diagnostics/firmware/src/diag_core.h **** 
 207:../../diagnostics/firmware/src/diag_core.h ****   private:
 208:../../diagnostics/firmware/src/diag_core.h ****     void Expire(uint32_t now_ms);
 209:../../diagnostics/firmware/src/diag_core.h ****     const char* bootloader_ = "unknown";
 210:../../diagnostics/firmware/src/diag_core.h ****     const Identity* identity_ = nullptr;
 211:../../diagnostics/firmware/src/diag_core.h ****     bool streaming_ = false;
 212:../../diagnostics/firmware/src/diag_core.h ****     uint32_t last_rx_ms_ = 0;
