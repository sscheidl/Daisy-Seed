  51:../../diagnostics/firmware/src/diag_core.h **** // (modulo 256) so pulses between two state frames stay visible; pulses shorter
  52:../../diagnostics/firmware/src/diag_core.h **** // than one control tick (1 ms) can be missed.
  53:../../diagnostics/firmware/src/diag_core.h **** class GateTracker {
