   1:src/pm_manager.h **** // Program manager core: operating modes, key selection, LED display, catalog scan
   2:src/pm_manager.h **** // and the hand-over to the loader. Portable (host-tested); main.cpp supplies the
   3:src/pm_manager.h **** // storage, target and boot commit, and feeds keys/card state once per main-loop step.
   4:src/pm_manager.h **** //
   5:src/pm_manager.h **** // Modes (docs/CONTRACT.md, section 8):
   6:src/pm_manager.h **** //   Select      keys 1..15 choose a catalog slot, key 16 opens the resident diagnostics
   7:src/pm_manager.h **** //   Diagnostics the diagnostics layer owns keys/LEDs; S1+S16 held 3 s returns to Select
   8:src/pm_manager.h **** //   Loading     a package is being checked and copied; keys are ignored
   9:src/pm_manager.h **** //   Service     a bootloader (DFU) entry was requested; the caller performs the reset
  10:src/pm_manager.h **** #pragma once
