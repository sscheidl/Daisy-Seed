 259:src/pm_main.cpp ****     static bool NameHasBin(const char* name) {
 260:src/pm_main.cpp ****         // ".bin" in any case anywhere in the name, as the bootloader's strstr(".bin"/".BIN")
 261:src/pm_main.cpp ****         // plus mixed case; conservative by design.
 262:src/pm_main.cpp ****         char lower[FF_MAX_LFN + 1];
 263:src/pm_main.cpp ****         size_t n = 0;
 264:src/pm_main.cpp ****         for(; name[n] && n < FF_MAX_LFN; ++n)
 265:src/pm_main.cpp ****             lower[n] = static_cast<char>(name[n] >= 'A' && name[n] <= 'Z' ? name[n] + 32 : name[n])
 266:src/pm_main.cpp ****         lower[n] = 0;
 267:src/pm_main.cpp ****         return std::strstr(lower, ".bin") != nullptr;
 268:src/pm_main.cpp ****     }
 269:src/pm_main.cpp ****     static const char* FsTypeName(BYTE type) {
 270:src/pm_main.cpp ****         switch(type) {
 271:src/pm_main.cpp ****             case FS_FAT12: return "FAT12";
 272:src/pm_main.cpp ****             case FS_FAT16: return "FAT16";
 273:src/pm_main.cpp ****             case FS_FAT32: return "FAT32";
 274:src/pm_main.cpp ****             case FS_EXFAT: return "EXFAT";
 275:src/pm_main.cpp ****             default: return "?";
 276:src/pm_main.cpp ****         }
 277:src/pm_main.cpp ****     }
 278:src/pm_main.cpp ****     bool mounted_ = false;
 279:src/pm_main.cpp ****     bool open_ = false;
