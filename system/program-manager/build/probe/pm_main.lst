  55:../../diagnostics/firmware/src/diag_core.h ****     void Update(size_t index, bool high);
  56:../../diagnostics/firmware/src/diag_core.h ****     uint8_t States() const { return states_; }  // bit 0 = GATE IN 1
  57:../../diagnostics/firmware/src/diag_core.h ****     uint8_t Count(size_t index) const { return count_[index]; }
  58:../../diagnostics/firmware/src/diag_core.h **** 
