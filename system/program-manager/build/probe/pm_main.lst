 185:../../diagnostics/firmware/src/diag_core.h **** // Command handling and host liveness. Streaming starts with HELLO and stops after
 186:../../diagnostics/firmware/src/diag_core.h **** // BYE or kHostTimeoutMs without a valid frame; only a new HELLO restarts it.
