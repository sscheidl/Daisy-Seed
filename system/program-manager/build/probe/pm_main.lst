  64:../../diagnostics/firmware/src/diag_core.h **** // Debounced button state between DigitalControl's rising and falling edges.
  65:../../diagnostics/firmware/src/diag_core.h **** // DigitalControl may report a second rising edge after a short contact dropout
  66:../../diagnostics/firmware/src/diag_core.h **** // without a falling edge in between; that is not counted as a new press.
