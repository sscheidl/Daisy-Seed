  71:../../diagnostics/firmware/src/diag_core.h ****     uint8_t PressCount(size_t index) const { return count_[index]; }
  72:../../diagnostics/firmware/src/diag_core.h **** 
  73:../../diagnostics/firmware/src/diag_core.h ****   private:
