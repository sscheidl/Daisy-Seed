  35:../../diagnostics/firmware/src/devkit_board.h ****         case daisy::System::BootInfo::Version::v6_0: return "v6_0";
  36:../../diagnostics/firmware/src/devkit_board.h ****         case daisy::System::BootInfo::Version::v6_1: return "v6_1";
  37:../../diagnostics/firmware/src/devkit_board.h ****         default: return "unknown";
  38:../../diagnostics/firmware/src/devkit_board.h ****     }
  39:../../diagnostics/firmware/src/devkit_board.h **** }
  40:../../diagnostics/firmware/src/devkit_board.h **** 
