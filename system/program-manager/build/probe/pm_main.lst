  60:src/pm_main.cpp **** // ---- Boot commit: the bootloader's existing JUMP order ----------------------------
  61:src/pm_main.cpp **** class DaisyBootCommit final : public pm::BootCommit {
  62:src/pm_main.cpp ****   public:
ARM GAS  C:\Users\ssche\AppData\Local\Temp\ccavsJkI.s 			page 25


  63:src/pm_main.cpp ****     void Quiesce() override {
  64:src/pm_main.cpp ****         // Nothing may write memory or run a transfer after this point: audio/control
  65:src/pm_main.cpp ****         // callback off, LEDs dark (last transfer waited for), card interface down.
  66:src/pm_main.cpp ****         hw.seed.StopAudio();
  67:src/pm_main.cpp ****         hw.ClearLeds();
  68:src/pm_main.cpp ****         hw.UpdateLeds();
  69:src/pm_main.cpp ****         hw.UpdateLeds();  // waits until the previous transfer has finished
  70:src/pm_main.cpp ****         hw.SetDacOut(DacHandle::Channel::ONE, 0);  // DAC code 0; electrical level NICHT GEMESSEN
  71:src/pm_main.cpp ****         hw.SetDacOut(DacHandle::Channel::TWO, 0);
  72:src/pm_main.cpp **** #ifdef PM_PROFILE_MANAGER
  73:src/pm_main.cpp ****         ro_sd_unmount();
  74:src/pm_main.cpp ****         if(hsd1.State != HAL_SD_STATE_RESET)
  75:src/pm_main.cpp ****             HAL_SD_DeInit(&hsd1);
  76:src/pm_main.cpp **** #endif
  77:src/pm_main.cpp ****     }
  78:src/pm_main.cpp ****     void Commit(uint32_t address) override {
  79:src/pm_main.cpp ****         // Same order as the bootloader itself and System::ResetToBootloader(): target
  80:src/pm_main.cpp ****         // first, status last, then an immediate software reset. The bootloader's
  81:src/pm_main.cpp ****         // startup_process() consumes JUMP and jumps to `address` before any init.
  82:src/pm_main.cpp ****         // Backup SRAM access was enabled by the bootloader (InitBackupSram).
  83:src/pm_main.cpp ****         __disable_irq();
  84:src/pm_main.cpp ****         boot_info.data = address;
  85:src/pm_main.cpp ****         __DSB();
  86:src/pm_main.cpp ****         boot_info.status = System::BootInfo::Type::JUMP;
  87:src/pm_main.cpp ****         __DSB();
  88:src/pm_main.cpp ****         RCC->CIER = 0x00000000;
  89:src/pm_main.cpp ****         HAL_NVIC_SystemReset();
  90:src/pm_main.cpp ****         while(true) {}
  91:src/pm_main.cpp ****     }
  92:src/pm_main.cpp **** };
