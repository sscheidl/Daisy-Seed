 248:../../diagnostics/firmware/src/devkit_board.h ****         SendResult result;
 249:../../diagnostics/firmware/src/devkit_board.h ****         if(hUsbDeviceHS.dev_state != USBD_STATE_CONFIGURED || hUsbDeviceHS.pClassData == nullptr)
 250:../../diagnostics/firmware/src/devkit_board.h ****             result = SendResult::NotReady;
 251:../../diagnostics/firmware/src/devkit_board.h ****         else if(usb_.TransmitExternal(const_cast<uint8_t*>(data), len) == daisy::UsbHandle::Result:
 252:../../diagnostics/firmware/src/devkit_board.h ****             result = SendResult::Ok;
 253:../../diagnostics/firmware/src/devkit_board.h ****         else
 254:../../diagnostics/firmware/src/devkit_board.h ****             result = SendResult::Busy;
 255:../../diagnostics/firmware/src/devkit_board.h ****         __set_BASEPRI(saved);
 256:../../diagnostics/firmware/src/devkit_board.h ****         return result;
